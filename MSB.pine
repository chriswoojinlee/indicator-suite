//@version=6
indicator("MSB", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=200)

// ─────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────

atrLen               = input.int(14, "ATR Length", minval=5, maxval=50, tooltip="Period for ATR calculation used in pivot confirmation.")
atrConfirmMult       = input.float(0.75, "ATR Confirmation Multiplier", minval=0.1, maxval=3.0, step=0.05, tooltip="Price must move this many ATRs away from a candidate swing to confirm it as a pivot. Lower = faster confirmation, more pivots. Higher = slower, cleaner.")
pivotSource          = input.string("Close", "Pivot Source", options=["Close", "Wick"], tooltip="Close: candle body closes. Wick: high/low wicks.")

alertBullMSB         = input.bool(true, "Alert on Bullish MSB", group="Alerts")
alertBearMSB         = input.bool(true, "Alert on Bearish MSB", group="Alerts")

// ─────────────────────────────────────────────────────────────
// COLORS
// ─────────────────────────────────────────────────────────────

color BULL_COLOR       = color.green
color BEAR_COLOR       = color.red
color BULL_LABEL_COLOR = color.green
color BEAR_LABEL_COLOR = color.red

// ─────────────────────────────────────────────────────────────
// ATR
// ─────────────────────────────────────────────────────────────

atrValue = ta.atr(atrLen)

// ─────────────────────────────────────────────────────────────
// ATR-ADAPTIVE PIVOT DETECTION
// ─────────────────────────────────────────────────────────────

srcHigh = pivotSource == "Close" ? close : high
srcLow  = pivotSource == "Close" ? close : low

var float candidateHigh      = na
var int   candidateHighBar   = na
var float candidateLow       = na
var int   candidateLowBar    = na

var float lastPivotHigh      = na
var int   lastPivotHighBar   = na
var float lastPivotLow       = na
var int   lastPivotLowBar    = na

var int swingDir = 0

pivotHighConfirmed = false
pivotLowConfirmed  = false

atrThresh = atrValue * atrConfirmMult

if bar_index > atrLen
    if swingDir >= 0
        if na(candidateHigh) or srcHigh > candidateHigh
            candidateHigh    := srcHigh
            candidateHighBar := bar_index

        dropFromHigh = candidateHigh - srcLow
        if dropFromHigh >= atrThresh and not na(candidateHigh)
            lastPivotHigh      := candidateHigh
            lastPivotHighBar   := candidateHighBar
            pivotHighConfirmed := true
            swingDir           := -1
            candidateLow       := srcLow
            candidateLowBar    := bar_index
            candidateHigh      := na
            candidateHighBar   := na

    if swingDir == -1 and not pivotHighConfirmed
        if na(candidateLow) or srcLow < candidateLow
            candidateLow    := srcLow
            candidateLowBar := bar_index

        riseFromLow = srcHigh - candidateLow
        if riseFromLow >= atrThresh and not na(candidateLow)
            lastPivotLow      := candidateLow
            lastPivotLowBar   := candidateLowBar
            pivotLowConfirmed := true
            swingDir          := 1
            candidateHigh     := srcHigh
            candidateHighBar  := bar_index
            candidateLow      := na
            candidateLowBar   := na

// ─────────────────────────────────────────────────────────────
// TREND STATE
// ─────────────────────────────────────────────────────────────

var int trend = 0

// ─────────────────────────────────────────────────────────────
// COUNTER-TREND PIVOT TRACKING
// ─────────────────────────────────────────────────────────────

var float activePivotLevel    = na
var int   activePivotBar      = na

var line  activePivotLine     = na
needsPivotRedraw = false

if trend > 0 and pivotLowConfirmed
    activePivotLevel := lastPivotLow
    activePivotBar   := lastPivotLowBar
    needsPivotRedraw := true

if trend < 0 and pivotHighConfirmed
    activePivotLevel := lastPivotHigh
    activePivotBar   := lastPivotHighBar
    needsPivotRedraw := true

if trend == 0 and (pivotHighConfirmed or pivotLowConfirmed)
    needsPivotRedraw := true

// ─────────────────────────────────────────────────────────────
// MSB DETECTION (counter-trend only)
// ─────────────────────────────────────────────────────────────

bullMSB = false
if trend <= 0
    float levelToBreak = trend < 0 and not na(activePivotLevel) ? activePivotLevel : lastPivotHigh
    if not na(levelToBreak)
        if close > levelToBreak and close[1] <= levelToBreak
            bullMSB := true

bearMSB = false
if trend >= 0
    float levelToBreak = trend > 0 and not na(activePivotLevel) ? activePivotLevel : lastPivotLow
    if not na(levelToBreak)
        if close < levelToBreak and close[1] >= levelToBreak
            bearMSB := true

// ─────────────────────────────────────────────────────────────
// DEDUPLICATION
// ─────────────────────────────────────────────────────────────

var float lastBullMSBLevel = na
var float lastBearMSBLevel = na

float bullBreakLevel = trend < 0 and not na(activePivotLevel) ? activePivotLevel : lastPivotHigh
float bearBreakLevel = trend > 0 and not na(activePivotLevel) ? activePivotLevel : lastPivotLow

bullMSBValid = bullMSB and (na(lastBullMSBLevel) or bullBreakLevel != lastBullMSBLevel or trend <= 0)
bearMSBValid = bearMSB and (na(lastBearMSBLevel) or bearBreakLevel != lastBearMSBLevel or trend >= 0)

var float msbBrokenLevel    = na
var int   msbBrokenLevelBar = na

if bullMSBValid
    msbBrokenLevel    := bullBreakLevel
    msbBrokenLevelBar := trend < 0 and not na(activePivotBar) ? activePivotBar : lastPivotHighBar

if bearMSBValid
    msbBrokenLevel    := bearBreakLevel
    msbBrokenLevelBar := trend > 0 and not na(activePivotBar) ? activePivotBar : lastPivotLowBar

// ─────────────────────────────────────────────────────────────
// TREND FLIP + STATE UPDATE
// ─────────────────────────────────────────────────────────────

if bullMSBValid
    trend            := 1
    lastBullMSBLevel := bullBreakLevel
    activePivotLevel := lastPivotLow
    activePivotBar   := lastPivotLowBar
    needsPivotRedraw := true

if bearMSBValid
    trend            := -1
    lastBearMSBLevel := bearBreakLevel
    activePivotLevel := lastPivotHigh
    activePivotBar   := lastPivotHighBar
    needsPivotRedraw := true

// ─────────────────────────────────────────────────────────────
// REDRAW ACTIVE PIVOT LINE
// ─────────────────────────────────────────────────────────────

if needsPivotRedraw
    if not na(activePivotLine)
        line.delete(activePivotLine)

    if trend > 0 and not na(activePivotLevel)
        activePivotLine := line.new(
             x1=activePivotBar, y1=activePivotLevel,
             x2=bar_index, y2=activePivotLevel,
             color=BEAR_COLOR, style=line.style_dashed, width=1)
    else if trend < 0 and not na(activePivotLevel)
        activePivotLine := line.new(
             x1=activePivotBar, y1=activePivotLevel,
             x2=bar_index, y2=activePivotLevel,
             color=BULL_COLOR, style=line.style_dashed, width=1)
    else if trend == 0 and not na(lastPivotLow)
        activePivotLine := line.new(
             x1=lastPivotLowBar, y1=lastPivotLow,
             x2=bar_index, y2=lastPivotLow,
             color=BEAR_COLOR, style=line.style_dashed, width=1)

// Extend pivot line to current bar on every bar (not just on redraw)
if not na(activePivotLine)
    line.set_x2(activePivotLine, bar_index)

// ─────────────────────────────────────────────────────────────
// VISUAL: SINGLE MSB ON CHART
// ─────────────────────────────────────────────────────────────

var label activeMSBLabel = na
var line  activeMSBLine  = na

if bullMSBValid
    if not na(activeMSBLabel)
        label.delete(activeMSBLabel)
    if not na(activeMSBLine)
        line.delete(activeMSBLine)

    activeMSBLabel := label.new(
         x=bar_index, y=low,
         text="MSB", style=label.style_label_up,
         color=BULL_LABEL_COLOR, textcolor=color.white, size=size.small)

    activeMSBLine := line.new(
         x1=msbBrokenLevelBar, y1=msbBrokenLevel,
         x2=bar_index, y2=msbBrokenLevel,
         color=BULL_COLOR, style=line.style_solid, width=1)

if bearMSBValid
    if not na(activeMSBLabel)
        label.delete(activeMSBLabel)
    if not na(activeMSBLine)
        line.delete(activeMSBLine)

    activeMSBLabel := label.new(
         x=bar_index, y=high,
         text="MSB", style=label.style_label_down,
         color=BEAR_LABEL_COLOR, textcolor=color.white, size=size.small)

    activeMSBLine := line.new(
         x1=msbBrokenLevelBar, y1=msbBrokenLevel,
         x2=bar_index, y2=msbBrokenLevel,
         color=BEAR_COLOR, style=line.style_solid, width=1)

// ─────────────────────────────────────────────────────────────
// PLOTS (all hidden from status line)
// ─────────────────────────────────────────────────────────────

plot(lastPivotHigh, "Last Pivot High", color=color.new(color.white, 100), display=display.data_window)
plot(lastPivotLow, "Last Pivot Low", color=color.new(color.white, 100), display=display.data_window)
plot(activePivotLevel, "Active Pivot Level", color=color.new(color.white, 100), display=display.data_window)
plot(bullMSBValid ? 1 : 0, "Bull MSB Signal", color=color.new(color.white, 100), display=display.data_window)
plot(bearMSBValid ? 1 : 0, "Bear MSB Signal", color=color.new(color.white, 100), display=display.data_window)
plot(trend, "Trend State", color=color.new(color.white, 100), display=display.data_window)

// ─────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────

alertcondition(bullMSBValid and alertBullMSB and barstate.isconfirmed, title="Bullish MSB", message="Bullish MSB: Trend flipped bullish on {{ticker}} {{interval}}")
alertcondition(bearMSBValid and alertBearMSB and barstate.isconfirmed, title="Bearish MSB", message="Bearish MSB: Trend flipped bearish on {{ticker}} {{interval}}")
alertcondition((bullMSBValid and alertBullMSB or bearMSBValid and alertBearMSB) and barstate.isconfirmed, title="Any MSB", message="MSB trend flip on {{ticker}} {{interval}}")
