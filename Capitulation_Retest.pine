// ═══════════════════════════════════════════════════════════════
// CAPITULATION RETEST — 12H (FINAL v4)
// ═══════════════════════════════════════════════════════════════
// MM-style passive accumulation. Proactive compound limits.
// One order per 12H candle. No range stop. Hard inval only.
// Closest possible adaptation of mentor's 2D mechanics.
//@version=6
strategy("Capitulation Retest 12H",
     overlay            = true,
     pyramiding         = 3,
     default_qty_type   = strategy.percent_of_equity,
     default_qty_value  = 75,
     commission_type    = strategy.commission.percent,
     commission_value   = 0,
     slippage           = 0,
     margin_long        = 1,
     margin_short       = 1,
     calc_on_every_tick = true,
     process_orders_on_close = true)

// ── PARAMETERS ───────────────────────────────────────────────

WICK_THR    = 2.725
TP_FIB      = 0.57
IMPULSE     = 2
HARD_PCT    = 12.247
VALID_TF    = timeframe.in_seconds() / 3600.0 == 12

QTY_1       = 2
QTY_2       = 3
QTY_3       = 5

// ── VISUALS ──────────────────────────────────────────────────

colLong  = input.color(color.green, "Long Color",  group="Visuals")
colShort = input.color(color.red,   "Short Color", group="Visuals")

// ── CALCULATIONS ─────────────────────────────────────────────

upperWick    = high - math.max(open, close)
lowerWick    = math.min(open, close) - low
upperWickPct = (upperWick / close) * 100
lowerWickPct = (lowerWick / close) * 100

// ── IMPULSE ──────────────────────────────────────────────────

consecBull = 0
consecBear = 0
for i = 1 to IMPULSE
    if close[i] > open[i]
        consecBull += 1
    else
        break
for i = 1 to IMPULSE
    if close[i] < open[i]
        consecBear += 1
    else
        break

// ── DETECTION ────────────────────────────────────────────────

upperQ = VALID_TF and upperWickPct >= WICK_THR and consecBull >= IMPULSE
lowerQ = VALID_TF and lowerWickPct >= WICK_THR and consecBear >= IMPULSE

bool isLowerCap = false
bool isUpperCap = false

if lowerQ and upperQ
    if lowerWick >= upperWick
        isLowerCap := true
    else
        isUpperCap := true
else if lowerQ
    isLowerCap := true
else if upperQ
    isUpperCap := true

// ── STATE ────────────────────────────────────────────────────

var int   dir            = 0
var float rangeHigh      = na
var float rangeLow       = na
var float tp             = na
var float hardLvl        = na
var float initialEntry   = na
var int   entryCount     = 0
var int   setupBarIdx    = 0
var bool  initialPlaced  = false
var int   prevOpenTrades = 0
var int   lastFillBar    = -1

calcTP(float rH, float rL, int d) =>
    d == -1 ? rH - TP_FIB * (rH - rL) : rL + TP_FIB * (rH - rL)

calcHard(float rH, float rL, int d) =>
    d == -1 ? rH * (1 + HARD_PCT / 100) : rL * (1 - HARD_PCT / 100)

// ── NEW SETUP ────────────────────────────────────────────────

bool justFormed = false

if dir == 0
    if isLowerCap
        dir := -1, rangeHigh := high, rangeLow := low
        initialEntry := close
        tp := calcTP(high, low, -1), hardLvl := calcHard(high, low, -1)
        entryCount := 0, setupBarIdx := bar_index, initialPlaced := false
        prevOpenTrades := 0, lastFillBar := -1
        justFormed := true
    else if isUpperCap
        dir := 1, rangeHigh := high, rangeLow := low
        initialEntry := close
        tp := calcTP(high, low, 1), hardLvl := calcHard(high, low, 1)
        entryCount := 0, setupBarIdx := bar_index, initialPlaced := false
        prevOpenTrades := 0, lastFillBar := -1
        justFormed := true

// ── ENTRIES (one per candle) ─────────────────────────────────
// Initial: limit at cap candle close.
// Compounds: standing limit at range extreme.
// Time gate: no new entry on the same bar as a previous fill.

if dir != 0 and bar_index > setupBarIdx
    bool canPlace = bar_index > lastFillBar

    if not initialPlaced and canPlace
        if dir == -1
            strategy.entry("S1", strategy.short, qty=QTY_1, limit=initialEntry)
        else
            strategy.entry("L1", strategy.long, qty=QTY_1, limit=initialEntry)
        initialPlaced := true
        entryCount := 1

    if initialPlaced and entryCount < 3 and canPlace
        float cq = entryCount == 1 ? QTY_2 : QTY_3
        string eid = (dir == -1 ? "S" : "L") + str.tostring(entryCount + 1)
        if dir == -1
            strategy.entry(eid, strategy.short, qty=cq, limit=rangeHigh)
        else
            strategy.entry(eid, strategy.long, qty=cq, limit=rangeLow)

// ── DETECT FILLS → UPDATE RANGE ──────────────────────────────
// Range only expands when a compound fills.
// One-candle gate: lastFillBar prevents stacking.

int openNow = strategy.opentrades
if dir != 0 and openNow > prevOpenTrades
    lastFillBar := bar_index
    if openNow > 1
        // Compound filled — expand range to where it filled
        if dir == -1 and high > rangeHigh
            rangeHigh := high
        if dir == 1 and low < rangeLow
            rangeLow := low
        tp := calcTP(rangeHigh, rangeLow, dir)
        hardLvl := calcHard(rangeHigh, rangeLow, dir)
    entryCount := openNow

prevOpenTrades := openNow

// Wick-side expansion (improves TP only)
if dir == -1 and low < rangeLow
    rangeLow := low
    tp := calcTP(rangeHigh, rangeLow, -1)
if dir == 1 and high > rangeHigh
    rangeHigh := high
    tp := calcTP(rangeHigh, rangeLow, 1)

// ── EXITS (TP only — no range stop) ─────────────────────────

if dir == -1 and entryCount >= 1
    strategy.exit("X1", from_entry="S1", limit=tp)
if dir == -1 and entryCount >= 2
    strategy.exit("X2", from_entry="S2", limit=tp)
if dir == -1 and entryCount >= 3
    strategy.exit("X3", from_entry="S3", limit=tp)

if dir == 1 and entryCount >= 1
    strategy.exit("X1", from_entry="L1", limit=tp)
if dir == 1 and entryCount >= 2
    strategy.exit("X2", from_entry="L2", limit=tp)
if dir == 1 and entryCount >= 3
    strategy.exit("X3", from_entry="L3", limit=tp)

// ── HARD INVALIDATION (bar-close only) ───────────────────────

bool hardInval = false
if dir == -1 and entryCount > 0 and close > hardLvl
    hardInval := true
if dir == 1 and entryCount > 0 and close < hardLvl
    hardInval := true

if hardInval and dir != 0
    strategy.close_all(comment="HARD INVAL")
    dir := 0, entryCount := 0, initialPlaced := false

// ── RESET ON FLAT ────────────────────────────────────────────

if dir != 0 and strategy.position_size == 0 and strategy.opentrades == 0 and entryCount >= 3 and bar_index > setupBarIdx + 1
    dir := 0, entryCount := 0, initialPlaced := false

if dir != 0 and strategy.position_size == 0 and strategy.opentrades == 0 and bar_index > setupBarIdx + 120
    dir := 0, entryCount := 0, initialPlaced := false

// ── ALERTS ───────────────────────────────────────────────────

if justFormed
    string dirStr = dir == -1 ? "SHORT" : "LONG"
    alert(syminfo.ticker + " 12H — " + dirStr + " Capitulation Setup. Entry at " + str.tostring(initialEntry, format.mintick) + ". TP: " + str.tostring(tp, format.mintick), alert.freq_once_per_bar)

alertcondition(isLowerCap or isUpperCap, "Setup Forming", "Capitulation retest setup detected.")

// ── STATUS LABEL ─────────────────────────────────────────────

var label statusLbl = na
if not na(statusLbl)
    label.delete(statusLbl)

if VALID_TF
    int lblX = bar_index + 12
    if dir == 0
        statusLbl := label.new(lblX, close, "The Strategy is in Idle Mode, patience requested.\n\nAnd simply wait for a setup to form.", color=color.new(color.gray, 90), textcolor=color.gray, style=label.style_label_left, size=size.large, textalign=text.align_left)
    else
        string candleType = dir == -1 ? "Bearish" : "Bullish"
        string dirWord    = dir == -1 ? "Short" : "Long"
        color  dirCol     = dir == -1 ? colShort : colLong
        string txt = "A " + candleType + " Candle Printed. Enter a Capitulation Setup " + dirWord + " on this candle close!\n\nTP: " + str.tostring(tp, format.mintick) + "\nHard: " + str.tostring(hardLvl, format.mintick)
        statusLbl := label.new(lblX, close, txt, color=color.new(dirCol, 90), textcolor=dirCol, style=label.style_label_left, size=size.large, textalign=text.align_left)
