//@version=5
indicator("BTC/ETH MMD", "BTC/ETH MMD", overlay = true, max_lines_count = 500, max_labels_count = 500)
//------------------------------------------------------------------------------
//Settings
//-----------------------------------------------------------------------------{
length = input.int(3, 'Pivot Lookback', minval = 2)
sym_btc = input.symbol('BINANCE:BTCUSDT.P', 'BTC Symbol')
sym_eth = input.symbol('BINANCE:ETHUSDT.P', 'ETH Symbol')

//Style
bullDivCss = input.color(color.red, 'Strong Bear (Swing High)', group = 'Style')
bearDivCss = input.color(color.green, 'Strong Bull (Swing Low)', group = 'Style')

//-----------------------------------------------------------------------------}
// Check if current chart is BTC/ETH
//-----------------------------------------------------------------------------{
isBTC = str.contains(syminfo.ticker, "BTC") or str.contains(syminfo.basecurrency, "BTC")
isETH = str.contains(syminfo.ticker, "ETH") or str.contains(syminfo.basecurrency, "ETH")
isValidPair = isBTC or isETH

//-----------------------------------------------------------------------------}
//Function
//-----------------------------------------------------------------------------{
n = bar_index

get_hl() => [high, low, close]

//Detect strong divergences only
get_strong_divergence(ph, y2, btc_y2, eth_y2, css)=>
    var float y1 = na
    var float btc_y1 = na
    var float eth_y1 = na
    var int x1 = na
    var strong_mmd = 0

    if y2 != y2[1] and btc_y2 != btc_y2[1] and eth_y2 != eth_y2[1]
        // For pivot HIGHS (bearish): BTC makes LH while ETH makes HH
        if ph
            btc_lower = btc_y2 < btc_y1  // BTC making lower high
            eth_higher = eth_y2 > eth_y1  // ETH making higher high
            
            if btc_lower and eth_higher
                line.new(n[length], y2, x1, y1, color = css)
                strong_mmd += 1
        
        // For pivot LOWS (bullish): BTC makes HL while ETH makes LL
        else
            btc_higher = btc_y2 > btc_y1  // BTC making higher low
            eth_lower = eth_y2 < eth_y1   // ETH making lower low
            
            if btc_higher and eth_lower
                line.new(n[length], y2, x1, y1, color = css)
                strong_mmd += 1
        
        btc_y1 := btc_y2
        eth_y1 := eth_y2
        y1 := y2
        x1 := n[length]
    else if (ph and y2 > y2[1]) or (not ph and y2 < y2[1])
        btc_y1 := na
        eth_y1 := na
        y1 := y2
        x1 := n[length]
    
    strong_mmd

//-----------------------------------------------------------------------------}
//Main variables
//-----------------------------------------------------------------------------{
var phN = 0, var plN = 0
var ph_strong_mmd = 0.
var pl_strong_mmd = 0.

//-----------------------------------------------------------------------------}
//Get BTC and ETH data
//-----------------------------------------------------------------------------{
[h_btc, l_btc, c_btc] = request.security(sym_btc, timeframe.period, get_hl())
[h_eth, l_eth, c_eth] = request.security(sym_eth, timeframe.period, get_hl())

//-----------------------------------------------------------------------------}
//Detect swing highs/lows and strong divergences
//-----------------------------------------------------------------------------{
if isValidPair
    ph = fixnan(ta.pivothigh(length, length))
    pl = fixnan(ta.pivotlow(length, length))
    phN += ph != ph[1] ? 1 : 0
    plN += pl != pl[1] ? 1 : 0

    // Calculate BTC and ETH pivots
    btc_ph = fixnan(ta.pivothigh(h_btc, length, length))
    btc_pl = fixnan(ta.pivotlow(l_btc, length, length))
    
    eth_ph = fixnan(ta.pivothigh(h_eth, length, length))
    eth_pl = fixnan(ta.pivotlow(l_eth, length, length))

    // Detect strong divergences
    ph_strong_mmd := get_strong_divergence(true, ph, btc_ph, eth_ph, bullDivCss)
    pl_strong_mmd := get_strong_divergence(false, pl, btc_pl, eth_pl, bearDivCss)

    // Create labels
    if ph != ph[1] and ph_strong_mmd > ph_strong_mmd[1]
        label.new(n[length], ph, 'MMD'
          , color = bullDivCss
          , style = label.style_label_down
          , textcolor = color.white
          , size = size.small)
    
    if pl != pl[1] and pl_strong_mmd > pl_strong_mmd[1]
        label.new(n[length], pl, 'MMD'
          , color = bearDivCss
          , style = label.style_label_up
          , textcolor = color.white
          , size = size.small)