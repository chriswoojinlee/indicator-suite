//@version=5
indicator("Multi-Asset MMD", "MMD", overlay = true, max_lines_count = 500, max_labels_count = 500)

// =========================================================================
// HARDCODED BEHAVIOR PARAMETERS (edit here if needed)
// =========================================================================
int EXTERNAL_PIVOT_DEPTH = 5    // 0 = disable external filter
int MAX_SIGNALS_SHOWN    = 5
int SYNC_WINDOW          = 10   // both assets must alternate within this many bars for a valid comparison

// =========================================================================
// INPUTS
// =========================================================================
g1A = input.symbol('BINANCE:BTCUSDT.P', 'Asset A', group = 'Symbols - Crypto (BTC vs ETH)')
g1B = input.symbol('BINANCE:ETHUSDT.P', 'Asset B', group = 'Symbols - Crypto (BTC vs ETH)')
g2A = input.symbol('COMEX:GC1!',        'Asset A', group = 'Symbols - Metals (Gold vs Silver)')
g2B = input.symbol('COMEX:SI1!',        'Asset B', group = 'Symbols - Metals (Gold vs Silver)')
g3A = input.symbol('CME_MINI:ES1!',     'Asset A', group = 'Symbols - Indices (S&P vs Nasdaq)')
g3B = input.symbol('CME_MINI:NQ1!',     'Asset B', group = 'Symbols - Indices (S&P vs Nasdaq)')

cBear = input.color(color.red,   'Bear (swing high)', group = 'Style')
cBull = input.color(color.green, 'Bull (swing low)',  group = 'Style')

// =========================================================================
// TIGHT ASSET DETECTION
// =========================================================================
chartId   = syminfo.tickerid
isCrypto  = chartId == g1A or chartId == g1B
isMetals  = chartId == g2A or chartId == g2B
isIndices = chartId == g3A or chartId == g3B
isValid   = isCrypto or isMetals or isIndices

// =========================================================================
// EXTERNAL DATA
// =========================================================================
[hA1, lA1] = request.security(g1A, timeframe.period, [high, low])
[hB1, lB1] = request.security(g1B, timeframe.period, [high, low])
[hA2, lA2] = request.security(g2A, timeframe.period, [high, low])
[hB2, lB2] = request.security(g2B, timeframe.period, [high, low])
[hA3, lA3] = request.security(g3A, timeframe.period, [high, low])
[hB3, lB3] = request.security(g3B, timeframe.period, [high, low])

hA = isCrypto ? hA1 : isMetals ? hA2 : isIndices ? hA3 : float(na)
lA = isCrypto ? lA1 : isMetals ? lA2 : isIndices ? lA3 : float(na)
hB = isCrypto ? hB1 : isMetals ? hB2 : isIndices ? hB3 : float(na)
lB = isCrypto ? lB1 : isMetals ? lB2 : isIndices ? lB3 : float(na)

// =========================================================================
// STRUCTURAL PIVOT DETECTION
// 3-candle fractal + alternation filter, mirroring the MSI indicator.
// Same-type pivots within a segment are absorbed via extension (overwrite
// if more extreme); opposite-type pivots trigger alternation and save the
// just-ended segment's extreme as the previous structural pivot.
// =========================================================================
detectStructPivot(srcH, srcL) =>
    isPivotHigh = srcH[1] >= srcH[2] and srcH[1] >= srcH[0] and (srcH[1] > srcH[2] or srcH[1] > srcH[0])
    isPivotLow  = srcL[1] <= srcL[2] and srcL[1] <= srcL[0] and (srcL[1] < srcL[2] or srcL[1] < srcL[0])

    var float structHigh        = na
    var int   structHighBar     = na
    var float prevStructHigh    = na
    var int   prevStructHighBar = na
    var float structLow         = na
    var int   structLowBar      = na
    var float prevStructLow     = na
    var int   prevStructLowBar  = na
    var int   lastAcceptedType  = 0

    altH = false
    altL = false

    if isPivotHigh
        pivotHighVal = srcH[1]
        if lastAcceptedType != 1
            prevStructHigh    := structHigh
            prevStructHighBar := structHighBar
            structHigh        := pivotHighVal
            structHighBar     := bar_index - 1
            lastAcceptedType  := 1
            altH              := true
        else if pivotHighVal > structHigh
            structHigh    := pivotHighVal
            structHighBar := bar_index - 1

    if isPivotLow
        pivotLowVal = srcL[1]
        if lastAcceptedType != -1
            prevStructLow    := structLow
            prevStructLowBar := structLowBar
            structLow        := pivotLowVal
            structLowBar     := bar_index - 1
            lastAcceptedType := -1
            altL             := true
        else if pivotLowVal < structLow
            structLow    := pivotLowVal
            structLowBar := bar_index - 1

    [structHigh, structHighBar, prevStructHigh, prevStructHighBar, structLow, structLowBar, prevStructLow, prevStructLowBar, altH, altL]

// =========================================================================
// CLASSIFIER (sweep-XOR)
// Divergence = exactly one asset sweeps past its prior swing while the
// other fails to. "Fails" includes equal highs/lows - stopping exactly at
// the prior level is a hold, not a sweep. isHigh=true compares sweeps
// above prior highs; false compares sweeps below prior lows.
// =========================================================================
isSweepDiv(aC, aP, bC, bP, isHigh) =>
    aSweep = isHigh ? aC > aP : aC < aP
    bSweep = isHigh ? bC > bP : bC < bP
    aSweep != bSweep

// =========================================================================
// RUN DETECTION
// =========================================================================
[cSH, cSHbar, cpSH, cpSHbar, cSL, cSLbar, cpSL, cpSLbar, cAltH, cAltL] = detectStructPivot(high, low)
[aSH, aSHbar, apSH, apSHbar, aSL, aSLbar, apSL, apSLbar, aAltH, aAltL] = detectStructPivot(hA,   lA)
[bSH, bSHbar, bpSH, bpSHbar, bSL, bSLbar, bpSL, bpSLbar, bAltH, bAltL] = detectStructPivot(hB,   lB)

// =========================================================================
// SWING-CYCLE SYNCHRONIZATION
// A comparison is only valid when BOTH assets have alternated on the same
// side within SYNC_WINDOW bars. The signal evaluates at the SECOND asset's
// alternation, guaranteeing both curr pivots belong to the same swing
// cycle. Without this, the earlier-confirming asset gets compared against
// the partner's stale pivot from the previous cycle, producing spurious
// divergences (both assets making HLs flagged as divergent because one
// confirmed a bar later).
// =========================================================================
// Pending-pair mechanism: each side (L/H) tracks whether each asset has an
// UNCONSUMED alternation. Evaluation happens only when both assets hold an
// unconsumed alternation simultaneously; both flags are then consumed.
// Pendings expire after SYNC_WINDOW bars. This guarantees the compared
// pivots come from paired swing cycles - an asset's stale pivot from a
// prior cycle can never be consumed against the partner's fresh one.
// NOTE: an asset alternating on the opposite side does NOT cancel its
// pending - the opposite alternation finalizes the pivot, it doesn't
// invalidate it. Cancelling here suppressed legitimate signals at V-tops/
// V-bottoms where one asset completes its reversal before the partner's
// same-side fractal confirms.
var bool aPendL = false
var bool bPendL = false
var int  aPendLBar = na
var int  bPendLBar = na
var bool aPendH = false
var bool bPendH = false
var int  aPendHBar = na
var int  bPendHBar = na

if aAltL
    aPendL    := true
    aPendLBar := bar_index
if bAltL
    bPendL    := true
    bPendLBar := bar_index
if aAltH
    aPendH    := true
    aPendHBar := bar_index
if bAltH
    bPendH    := true
    bPendHBar := bar_index

// Expiry
if aPendL and (bar_index - aPendLBar) > SYNC_WINDOW
    aPendL := false
if bPendL and (bar_index - bPendLBar) > SYNC_WINDOW
    bPendL := false
if aPendH and (bar_index - aPendHBar) > SYNC_WINDOW
    aPendH := false
if bPendH and (bar_index - bPendHBar) > SYNC_WINDOW
    bPendH := false

syncedL = aPendL and bPendL
syncedH = aPendH and bPendH

// Consume on evaluation
if syncedL
    aPendL := false
    bPendL := false
if syncedH
    aPendH := false
    bPendH := false

// =========================================================================
// PIVOT HISTORY (finalized segment extremes, pushed at opposite alternation)
// =========================================================================
var array<float> aPivotLows  = array.new<float>()
var array<float> bPivotLows  = array.new<float>()
var array<float> aPivotHighs = array.new<float>()
var array<float> bPivotHighs = array.new<float>()

pushHist(array<float> arr, float val, int depth) =>
    array.push(arr, val)
    while array.size(arr) > depth
        array.shift(arr)

if isValid and EXTERNAL_PIVOT_DEPTH > 0
    if aAltH and not na(aSL)
        pushHist(aPivotLows, aSL, EXTERNAL_PIVOT_DEPTH)
    if bAltH and not na(bSL)
        pushHist(bPivotLows, bSL, EXTERNAL_PIVOT_DEPTH)
    if aAltL and not na(aSH)
        pushHist(aPivotHighs, aSH, EXTERNAL_PIVOT_DEPTH)
    if bAltL and not na(bSH)
        pushHist(bPivotHighs, bSH, EXTERNAL_PIVOT_DEPTH)

// =========================================================================
// SIGNAL TRACKING (FIFO cap)
// =========================================================================
var array<line>  sigLines  = array.new<line>()
var array<label> sigLabels = array.new<label>()

addSig(line ln, label lb) =>
    array.push(sigLines,  ln)
    array.push(sigLabels, lb)
    while array.size(sigLabels) > MAX_SIGNALS_SHOWN
        oldLn = array.shift(sigLines)
        oldLb = array.shift(sigLabels)
        if not na(oldLn)
            line.delete(oldLn)
        if not na(oldLb)
            label.delete(oldLb)

// =========================================================================
// DEDUP & SIGNAL STATE
// =========================================================================
var float lastSigLowAprev  = na
var float lastSigLowBprev  = na
var float lastSigHighAprev = na
var float lastSigHighBprev = na

var bool sigBearH = false
var bool sigBullL = false
sigBearH := false
sigBullL := false

// =========================================================================
// SWING LOW MMD - evaluates when either asset alternates AND both are synced
// =========================================================================
if isValid and syncedL
    aCurrL = aSL
    aPrevL = apSL
    bCurrL = bSL
    bPrevL = bpSL

    if not na(aCurrL) and not na(aPrevL) and not na(bCurrL) and not na(bPrevL)
        sameAsLast = not na(lastSigLowAprev) and not na(lastSigLowBprev) and aPrevL == lastSigLowAprev and bPrevL == lastSigLowBprev

        if not sameAsLast and isSweepDiv(aCurrL, aPrevL, bCurrL, bPrevL, false)
            externalOK = EXTERNAL_PIVOT_DEPTH == 0
            if not externalOK
                aSize    = array.size(aPivotLows)
                bSize    = array.size(bPivotLows)
                aHistMin = aSize > 0 ? array.min(aPivotLows) : float(na)
                bHistMin = bSize > 0 ? array.min(bPivotLows) : float(na)
                aIsExt   = not na(aHistMin) and aCurrL <= aHistMin
                bIsExt   = not na(bHistMin) and bCurrL <= bHistMin
                externalOK := (aSize == 0 and bSize == 0) or aIsExt or bIsExt

            if externalOK
                prov      = not barstate.isconfirmed
                sigColor  = prov ? color.new(cBull, 55) : cBull
                sigStyle  = prov ? line.style_dotted : line.style_solid
                line ln = na
                if not na(cpSLbar) and not na(cpSL) and not na(cSLbar) and not na(cSL)
                    ln := line.new(cpSLbar, cpSL, cSLbar, cSL, color = sigColor, width = 2, style = sigStyle)
                anchorBar   = not na(cSLbar) ? cSLbar : bar_index
                anchorPrice = not na(cSL)    ? cSL    : low
                lb = label.new(anchorBar, anchorPrice, 'MMD', color = sigColor, style = label.style_label_up, textcolor = color.white, size = size.small)
                addSig(ln, lb)
                lastSigLowAprev := aPrevL
                lastSigLowBprev := bPrevL
                sigBullL        := true

// =========================================================================
// SWING HIGH MMD - evaluates when either asset alternates AND both are synced
// =========================================================================
if isValid and syncedH
    aCurrH = aSH
    aPrevH = apSH
    bCurrH = bSH
    bPrevH = bpSH

    if not na(aCurrH) and not na(aPrevH) and not na(bCurrH) and not na(bPrevH)
        sameAsLast = not na(lastSigHighAprev) and not na(lastSigHighBprev) and aPrevH == lastSigHighAprev and bPrevH == lastSigHighBprev

        if not sameAsLast and isSweepDiv(aCurrH, aPrevH, bCurrH, bPrevH, true)
            externalOK = EXTERNAL_PIVOT_DEPTH == 0
            if not externalOK
                aSize    = array.size(aPivotHighs)
                bSize    = array.size(bPivotHighs)
                aHistMax = aSize > 0 ? array.max(aPivotHighs) : float(na)
                bHistMax = bSize > 0 ? array.max(bPivotHighs) : float(na)
                aIsExt   = not na(aHistMax) and aCurrH >= aHistMax
                bIsExt   = not na(bHistMax) and bCurrH >= bHistMax
                externalOK := (aSize == 0 and bSize == 0) or aIsExt or bIsExt

            if externalOK
                prov      = not barstate.isconfirmed
                sigColor  = prov ? color.new(cBear, 55) : cBear
                sigStyle  = prov ? line.style_dotted : line.style_solid
                line ln = na
                if not na(cpSHbar) and not na(cpSH) and not na(cSHbar) and not na(cSH)
                    ln := line.new(cpSHbar, cpSH, cSHbar, cSH, color = sigColor, width = 2, style = sigStyle)
                anchorBar   = not na(cSHbar) ? cSHbar : bar_index
                anchorPrice = not na(cSH)    ? cSH    : high
                lb = label.new(anchorBar, anchorPrice, 'MMD', color = sigColor, style = label.style_label_down, textcolor = color.white, size = size.small)
                addSig(ln, lb)
                lastSigHighAprev := aPrevH
                lastSigHighBprev := bPrevH
                sigBearH         := true

// =========================================================================
// ALERTS
// =========================================================================
// Transparent plots satisfy Pine's output requirement (display.none and
// conditional drawings don't count toward it)
plot(sigBullL ? 1 : 0, 'Bull MMD', color = color.new(color.white, 100), display = display.data_window)
plot(sigBearH ? 1 : 0, 'Bear MMD', color = color.new(color.white, 100), display = display.data_window)

alertcondition(sigBearH, 'MMD Bearish', 'MMD bearish divergence at swing high')
alertcondition(sigBullL, 'MMD Bullish', 'MMD bullish divergence at swing low')
