//@version=6
indicator("ATR", overlay=true)

// ============================================================================
// SETTINGS
// ============================================================================
atrLength = input.int(14, "ATR Length", minval=1, display=display.none)
atrSmaLength = input.int(20, "ATR SMA Length", minval=1, display=display.none)
tablePosition = input.string("Bottom Right", "Table Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], display=display.none)

// ============================================================================
// CALCULATIONS
// ============================================================================
atrValue = ta.atr(atrLength)
atrSma = ta.sma(atrValue, atrSmaLength)
atrPct = (atrValue / close) * 100
atrRatio = atrValue / atrSma

// ============================================================================
// TABLE POSITION
// ============================================================================
tablePos = switch tablePosition
    "Top Left" => position.top_left
    "Top Right" => position.top_right
    "Bottom Left" => position.bottom_left
    "Bottom Right" => position.bottom_right

// ============================================================================
// TABLE DISPLAY
// ============================================================================
var table atrTable = table.new(tablePos, 2, 3, bgcolor=color.new(color.black, 80), border_width=0)

if barstate.islast
    // Volatility state
    volState = atrRatio > 1.15 ? "EXPANDED" : atrRatio < 0.85 ? "COMPRESSED" : "NORMAL"
    volColor = atrRatio > 1.15 ? color.new(color.orange, 20) : atrRatio < 0.85 ? color.new(color.teal, 20) : color.new(color.gray, 20)
    
    // Row 0: ATR value
    table.cell(atrTable, 0, 0, "ATR", text_color=color.new(color.white, 40), text_size=size.small)
    table.cell(atrTable, 1, 0, str.tostring(atrValue, format.mintick), text_color=color.new(color.white, 10), text_size=size.small)
    
    // Row 1: ATR as % of price
    table.cell(atrTable, 0, 1, "ATR %", text_color=color.new(color.white, 40), text_size=size.small)
    table.cell(atrTable, 1, 1, str.tostring(atrPct, "#.##") + "%", text_color=color.new(color.white, 10), text_size=size.small)
    
    // Row 2: Volatility state
    table.cell(atrTable, 0, 2, "State", text_color=color.new(color.white, 40), text_size=size.small)
    table.cell(atrTable, 1, 2, volState, text_color=volColor, text_size=size.small)