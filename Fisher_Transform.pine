//@version=6
indicator(title="Fisher Transform", shorttitle="Fisher Transform")

//-----------------------------------------------------------------------------------------------------------------------------------------------------------------
//Functions
//-----------------------------------------------------------------------------------------------------------------------------------------------------------------

fish(x, t) =>
    highval = ta.highest(x, t)
    lowval  = ta.lowest(x, t)
    val1    = 0.0
    val1   := 0.66 * ((x - lowval) / math.max(highval - lowval, 0.001) - 0.5) + 0.67*nz(val1[1], 0)
    val2    = val1 > 0.99 ? 0.999 : val1 < -0.99 ? -0.999 : val1
    fish    = 0.0
    fish   := 0.5 * math.log((1 + val2) / math.max(1 - val2, 0.001)) + 0.5*nz(fish[1], 0)
    fish

dema(x, t) =>
    var float e1 = na
    var float e2 = na
    e1 := na(e1) ? x : x * (2.0 / (t + 1)) + e1 * (1.0 - 2.0 / (t + 1))
    e2 := na(e2) ? x : e1 * (2.0 / (t + 1)) + e2 * (1.0 - 2.0 / (t + 1))
    2.0 * e1 - e2

cmean(x)=>
    var xsum  = 0.0
    xsum     := xsum + x
    var tsum  = 0.0
    tsum     := tsum + 1
    cmean     = xsum/tsum
    cmean

comp(x, k_type, h_knee, l_knee, intensity)=>
    hk   = k_type=="Auto" ? cmean(math.abs(x)) : h_knee
    lk   = k_type=="Auto" ? -cmean(math.abs(x)) : l_knee
    comp = x > hk ? x - intensity*(x - hk)/100 :
           x < lk ? x + intensity*(lk - x)/100 : x
    comp

//-----------------------------------------------------------------------------------------------------------------------------------------------------------------
//Hardcoded Backend Settings
//-----------------------------------------------------------------------------------------------------------------------------------------------------------------

src = (high + low + close) / 3

tf_secs = timeframe.in_seconds(timeframe.period)

is_macro       = timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly or tf_secs > 43200
is_positional  = not is_macro and tf_secs > 7200 and tf_secs <= 43200
is_swing       = not is_macro and not is_positional and tf_secs >= 1800 and tf_secs <= 7200
is_intraday    = not is_macro and not is_positional and not is_swing and tf_secs > 300 and tf_secs < 1800
is_scalp       = not is_macro and not is_positional and not is_swing and not is_intraday

per = is_macro ? 24 : is_positional ? 18 : is_swing ? 15 : is_intraday ? 12 : 9

// Smoothing period scales with the lookback tier (per / 3, rounded)
smooth_per = is_macro ? 8 : is_positional ? 6 : is_swing ? 5 : is_intraday ? 4 : 3

custom_ht = is_macro ? 1.0 : is_positional ? 1.25 : is_swing ? 1.5 : is_intraday ? 1.75 : 2.0
custom_lt = is_macro ? -1.0 : is_positional ? -1.25 : is_swing ? -1.5 : is_intraday ? -1.75 : -2.0

zone_upper_boundary   = is_macro ? 4.0 : is_positional ? 4.25 : is_swing ? 4.5 : is_intraday ? 4.75 : 5.0
zone_lower_boundary   = is_macro ? -4.0 : is_positional ? -4.25 : is_swing ? -4.5 : is_intraday ? -4.75 : -5.0
zone_upper_threshold  = is_macro ? 1.5 : is_positional ? 1.75 : is_swing ? 2.0 : is_intraday ? 2.25 : 2.5
zone_lower_threshold  = is_macro ? -1.5 : is_positional ? -1.75 : is_swing ? -2.0 : is_intraday ? -2.25 : -2.5

show_zones = true
zone_transparency = 50
show_transition_circles = true
use_comp = true
comp_intensity = 25
show_signals = true

zone_overbought_color = color.red
zone_oversold_color = color.green
color_bullpower = color.green
color_bullforming = color.green
color_bullpullback = color.red
color_bearpower = color.red
color_bearforming = color.red
color_bearpullback = color.green
bull_to_bear_circle_color = color.red
bear_to_bull_circle_color = color.green
buy_signal_color = color.green
sell_signal_color = color.red

//-----------------------------------------------------------------------------------------------------------------------------------------------------------------
//Definitions
//-----------------------------------------------------------------------------------------------------------------------------------------------------------------

fisher        = nz(fish(src, per), 0)
fisher_smooth = dema(fisher, smooth_per)          // EMA applied to raw Fisher, before compression
osc           = use_comp ? comp(fisher_smooth, "Custom", custom_ht, custom_lt, comp_intensity) : fisher_smooth


hth = custom_ht
lth = custom_lt

bullpower    = (osc > 0) and (osc >= osc[1]) and (osc >= hth)
bullforming  = (osc > 0) and (osc > osc[1]) and (osc < hth)
bullpullback = (osc > 0) and (osc < osc[1])
bearpower    = (osc < 0) and (osc <= osc[1]) and (osc <= lth)
bearforming  = (osc < 0) and (osc < osc[1]) and (osc > lth)
bearpullback = (osc < 0) and (osc > osc[1])

osccolor = bullpower ? color_bullpower :
           bullforming ? color_bullforming :
           bullpullback ? color_bullpullback :
           bearpower ? color_bearpower :
           bearforming ? color_bearforming :
           bearpullback ? color_bearpullback :
           color.gray

basiscolor = osc > 0 ? color.green : osc < 0 ? color.red : #cccccc

prev_bullpower = bullpower[1]
prev_bullforming = bullforming[1]
prev_bullpullback = bullpullback[1]
prev_bearpower = bearpower[1] 
prev_bearforming = bearforming[1]
prev_bearpullback = bearpullback[1]

any_state_change = (bullpower != prev_bullpower) or 
                   (bullforming != prev_bullforming) or 
                   (bullpullback != prev_bullpullback) or 
                   (bearpower != prev_bearpower) or 
                   (bearforming != prev_bearforming) or 
                   (bearpullback != prev_bearpullback)

current_osc_is_green = (osccolor == color_bullpower) or (osccolor == color_bullforming) or (osccolor == color_bearpullback)
current_osc_is_red = (osccolor == color_bearpower) or (osccolor == color_bearforming) or (osccolor == color_bullpullback)

bull_to_bear_transition = any_state_change and current_osc_is_red
bear_to_bull_transition = any_state_change and current_osc_is_green

//-----------------------------------------------------------------------------------------------------------------------------------------------------------------
//Signal Detection
//-----------------------------------------------------------------------------------------------------------------------------------------------------------------

buy_signal = (osc <= lth) and (osc > osc[1]) and (osc[1] <= osc[2])
sell_signal = (osc >= hth) and (osc < osc[1]) and (osc[1] >= osc[2])

//-----------------------------------------------------------------------------------------------------------------------------------------------------------------
//Outputs
//-----------------------------------------------------------------------------------------------------------------------------------------------------------------

upper_zone_top = plot(show_zones ? zone_upper_boundary : na, display=display.none)
upper_zone_bottom = plot(show_zones ? zone_upper_threshold : na, display=display.none)
lower_zone_top = plot(show_zones ? zone_lower_threshold : na, display=display.none)
lower_zone_bottom = plot(show_zones ? zone_lower_boundary : na, display=display.none)

fill(upper_zone_top, upper_zone_bottom, color.new(zone_overbought_color, zone_transparency), title="Overbought Zone")
fill(lower_zone_top, lower_zone_bottom, color.new(zone_oversold_color, zone_transparency), title="Oversold Zone")

plot(0, color=#787B86, linewidth=1, title="Center Line", display=display.pane)

oscplot = plot(osc, color=osccolor, linewidth=1, title="Oscillator")

plotshape(show_transition_circles and bull_to_bear_transition ? osc[1] : na, 
          style=shape.circle, location=location.absolute, color=bull_to_bear_circle_color, size=size.small, 
          title="Bear Transition", offset=-1)
plotshape(show_transition_circles and bull_to_bear_transition ? osc[1] : na, 
          style=shape.circle, location=location.absolute, color=color.black, size=size.tiny, 
          title="Bear Inner", offset=-1)

plotshape(show_transition_circles and bear_to_bull_transition ? osc[1] : na, 
          style=shape.circle, location=location.absolute, color=bear_to_bull_circle_color, size=size.small, 
          title="Bull Transition", offset=-1)
plotshape(show_transition_circles and bear_to_bull_transition ? osc[1] : na, 
          style=shape.circle, location=location.absolute, color=color.black, size=size.tiny, 
          title="Bull Inner", offset=-1)

if show_signals and buy_signal
    label.new(bar_index, osc, text="B", style=label.style_label_up, color=buy_signal_color, 
              textcolor=color.white, size=size.normal, tooltip="Buy Signal")

if show_signals and sell_signal
    label.new(bar_index, osc, text="S", style=label.style_label_down, color=sell_signal_color, 
              textcolor=color.white, size=size.normal, tooltip="Sell Signal")

//-----------------------------------------------------------------------------------------------------------------------------------------------------------------
//Extreme Zone X Markers
//-----------------------------------------------------------------------------------------------------------------------------------------------------------------

extreme_upper_position = zone_upper_boundary + (zone_upper_boundary - zone_upper_threshold) / 2
extreme_lower_position = zone_lower_boundary - (zone_upper_boundary - zone_upper_threshold) / 2

show_extreme_marker = bar_index % 1 == 0

plotshape(show_extreme_marker ? extreme_upper_position : na, 
          style=shape.xcross, location=location.absolute, color=color.red, size=size.tiny, 
          title="Extreme Overbought")

plotshape(show_extreme_marker ? extreme_lower_position : na, 
          style=shape.xcross, location=location.absolute, color=color.green, size=size.tiny, 
          title="Extreme Oversold")

//-----------------------------------------------------------------------------------------------------------------------------------------------------------------
//Alerts
//-----------------------------------------------------------------------------------------------------------------------------------------------------------------

alertcondition(buy_signal, title="Fisher Buy Signal", message="Fisher Transform: Buy Signal Detected")
alertcondition(sell_signal, title="Fisher Sell Signal", message="Fisher Transform: Sell Signal Detected")
alertcondition(bull_to_bear_transition, title="Bull to Bear Transition", message="Fisher Transform: Bull to Bear Transition")
alertcondition(bear_to_bull_transition, title="Bear to Bull Transition", message="Fisher Transform: Bear to Bull Transition")
