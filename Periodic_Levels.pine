//@version=6
indicator("Periodic Levels", overlay=true, max_lines_count=500, max_labels_count=500)

// ─────────────────────────────────────────────────────────────
// 1. WEEKEND EXTREME
//    Weekend high/low that exceeds all 4 prior weekday extremes during
//    the cmeC phase.
//
//    TWO FEEDS, TWO JOBS:
//      - CME (BTC1!) decides WHETHER a level exists (qualification vs the
//        4 prior weekdays) and WHETHER it has been swept. CME is the
//        institutional venue: a level taken out there is consumed
//        liquidity even if the perp frontran it and never printed through.
//      - The CHART SYMBOL supplies the PRICE and WICK the line is drawn
//        at. CME front-month carries basis over a perp (often hundreds of
//        dollars on BTC), so drawing the CME price on a perp chart leaves
//        the line floating off the visible wick.
//
//    Net effect: the line sits on your chart's own wick, but it only
//    disappears when CME sweeps it.
//
//    - Emitted as a LIVE PREVIEW during the weekend, updating as the
//      extreme extends through the cmeC phase
//    - Promoted to a permanent level on weekend exit if unswept
//    - Catch-up path emits on LTF charts whose history predates the weekend
//
// 2. PERIOD OPENS (daily / weekly / monthly / quarterly / yearly)
//    Institutional reference points. Detected at 1H, anchored to the chart
//    bar whose span contains the boundary moment.
//    - Weekly open = Sunday 19:00 CT (start of Monday's UTC daily candle
//      in CDT); persists until Friday 16:00 CT
//    - Coincident opens merge: only the most significant level draws, and
//      the absorbed tags append to its label (e.g. "qO/mO")
//
// All lines use xloc.bar_index, clamped to bar_index - 9999 to stay inside
// Pine's lookback window on LTF charts where a level is many bars old.
// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────

string GRP_EXT   = "Weekend Extremes"
string GRP_DAILY = "Daily Open"
string GRP_WK    = "Weekly Open"
string GRP_MONTH = "Monthly Open"
string GRP_QTR   = "Quarterly Open"
string GRP_YEAR  = "Yearly Open"
string GRP_ALERT = "Alerts"

// ── Weekend Extremes ──
showExt    = input.bool(true, "Show Weekend Extremes", group=GRP_EXT, display=display.none)
highColor  = input.color(color.new(color.red,   50), "High Color", group=GRP_EXT, display=display.none)
lowColor   = input.color(color.new(color.green, 50), "Low Color",  group=GRP_EXT, display=display.none)
lineWidth  = input.int(1, "Line Width", minval=1, maxval=4, group=GRP_EXT, display=display.none)
lineStyle  = input.string("Dotted", "Line Style", options=["Solid","Dashed","Dotted"], group=GRP_EXT, display=display.none)
showLabels = input.bool(true, "Show Labels", group=GRP_EXT, display=display.none)
extSource  = input.string("CME", "Validation Source", options=["CME","Chart Symbol"], group=GRP_EXT, display=display.none,
             tooltip="Which venue decides whether a level qualifies and whether it has been swept. The line is always DRAWN at the chart symbol's own price so it sits on the visible wick.")
cmeSymbol  = input.symbol("CME:BTC1!", "CME Reference", group=GRP_EXT, display=display.none)
showSrcTag = input.bool(true, "Tag Validation Source", group=GRP_EXT, display=display.none,
             tooltip="Appends (CME) to the label when sweep validity is judged on a different venue than the chart.")

// ── Daily Open ──
showDailyOpen = input.bool(false, "Show Daily Open", group=GRP_DAILY, display=display.none)
dailyColor    = input.color(color.new(color.white, 50), "Color", group=GRP_DAILY, display=display.none)
dailyWidth    = input.int(1, "Line Width", minval=1, maxval=4, group=GRP_DAILY, display=display.none)
dOpenStyle    = input.string("Solid", "Line Style", options=["Solid","Dashed","Dotted"], group=GRP_DAILY, display=display.none)

// ── Weekly Open ──
showWkOpen      = input.bool(true, "Show Weekly Open", group=GRP_WK, display=display.none)
wkOpenColor     = input.color(color.new(color.white, 50), "Color", group=GRP_WK, display=display.none)
wkOpenLineWidth = input.int(1, "Line Width", minval=1, maxval=4, group=GRP_WK, display=display.none)
wkOpenStyle     = input.string("Solid", "Line Style", options=["Solid","Dashed","Dotted"], group=GRP_WK, display=display.none)

// ── Monthly Open ──
showMonthOpen = input.bool(true, "Show Monthly Open", group=GRP_MONTH, display=display.none)
monthColor    = input.color(color.new(color.white, 50), "Color", group=GRP_MONTH, display=display.none)
monthWidth    = input.int(1, "Line Width", minval=1, maxval=4, group=GRP_MONTH, display=display.none)
mOpenStyle    = input.string("Solid", "Line Style", options=["Solid","Dashed","Dotted"], group=GRP_MONTH, display=display.none)

// ── Quarterly Open ──
showQtrOpen = input.bool(false, "Show Quarterly Open", group=GRP_QTR, display=display.none)
qtrColor    = input.color(color.new(color.white, 50), "Color", group=GRP_QTR, display=display.none)
qtrWidth    = input.int(1, "Line Width", minval=1, maxval=4, group=GRP_QTR, display=display.none)
qOpenStyle  = input.string("Solid", "Line Style", options=["Solid","Dashed","Dotted"], group=GRP_QTR, display=display.none)

// ── Yearly Open ──
showYearOpen = input.bool(false, "Show Yearly Open", group=GRP_YEAR, display=display.none)
yearColor    = input.color(color.new(color.white, 50), "Color", group=GRP_YEAR, display=display.none)
yearWidth    = input.int(1, "Line Width", minval=1, maxval=4, group=GRP_YEAR, display=display.none)
yOpenStyle   = input.string("Solid", "Line Style", options=["Solid","Dashed","Dotted"], group=GRP_YEAR, display=display.none)

// ── Alerts ──
alertOnSweep = input.bool(true, "Alert On Sweep", group=GRP_ALERT, display=display.none)

// ─────────────────────────────────────────────────────────────
// CONSTANTS
// ─────────────────────────────────────────────────────────────

int maxExtLevels = 5
int extStaleMs   = 5 * 86400000
int biLookback   = 9999

bool isBTC = str.contains(str.upper(syminfo.basecurrency), "BTC") or
             str.contains(str.upper(syminfo.ticker), "BTC")

// ─────────────────────────────────────────────────────────────
// HELPERS
// ─────────────────────────────────────────────────────────────

getLineStyle(string s) =>
    switch s
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

f_safeBI(int storedBI) =>
    math.max(storedBI, bar_index - biLookback)

// Compute an anchor bar_index from a 1H boundary timestamp. Lands on the
// chart bar whose span contains that moment, on any chart timeframe,
// regardless of how many bars late the security delivers the value.
f_anchorBI(int ancT) =>
    int bms = timeframe.in_seconds(timeframe.period) * 1000
    float r = bms > 0 ? (time - ancT) / float(bms) : 0.0
    math.max(0, bar_index - math.max(0, int(math.ceil(r))))

// Draw (or clear) a single period reference level. Returns the new
// line/label so the caller can reassign its var state.
f_drawPeriodLevel(line oldLn, label oldLb, bool show, float p, int bi,
                  color col, int w, string lstyle, string txt) =>
    line.delete(oldLn)
    label.delete(oldLb)
    line  newLn = na
    label newLb = na
    if show and not na(p) and not na(bi)
        int x1 = f_safeBI(bi)
        int x2 = math.max(bar_index, x1 + 1)
        newLn := line.new(x1, p, x2, p, color=col, width=w, style=lstyle,
             extend=extend.right, xloc=xloc.bar_index)
        if showLabels
            newLb := label.new(bar_index, p, txt,
                 color=color.new(color.black, 100), textcolor=col,
                 style=close < p ? label.style_label_lower_left : label.style_label_upper_left,
                 size=size.small, xloc=xloc.bar_index)
    [newLn, newLb]

// ─────────────────────────────────────────────────────────────
// CHART-SIDE SESSION TRACKING
//
// fridayCloseFired marks the Friday 16:00 CT CME close, distinguishing it
// from the daily maintenance breaks Mon–Thu (which also flip chartInS but
// land on a different day of week). Used to retire the weekly open.
// ─────────────────────────────────────────────────────────────

int  chartDow = dayofweek(time, "America/Chicago")
int  chartHr  = hour(time,      "America/Chicago")
bool chartInS = not ((chartDow == 6 and chartHr >= 16) or chartDow == 7 or (chartDow == 1 and chartHr < 17))

var bool chartPrevS = true
bool fridayCloseFired = not chartInS and chartPrevS and chartDow == 6
chartPrevS := chartInS

// ─────────────────────────────────────────────────────────────
// 1H FUNCTION: WEEKEND EXTREMES (qualification)
//
// Returns the weekend high/low that exceeds all 4 prior weekday extremes,
// or na if the weekend failed to take out the prior week's range.
// Run on the VALIDATION venue.
// ─────────────────────────────────────────────────────────────

f_weekendExtremes() =>
    int  dow  = dayofweek(time, "America/Chicago")
    int  hr   = hour(time,      "America/Chicago")
    bool cmeC = (dow == 6 and hr >= 16) or dow == 7 or (dow == 1 and hr < 17)
    bool isWk = dayofweek(time, "UTC") == 7 or dayofweek(time, "UTC") == 1
    bool nd   = ta.change(time("D")) != 0

    var float d1H = na
    var float d1L = na
    var float d2H = na
    var float d2L = na
    var float d3H = na
    var float d3L = na
    var float d4H = na
    var float d4L = na
    var float cH  = na
    var float cL  = na
    var bool  inW = false
    var float wH  = na
    var int   wHT = na
    var float wL  = na
    var int   wLT = na
    var float rHP = na
    var int   rHT = na
    var float rLP = na
    var int   rLT = na

    if nd and not isWk and not inW
        d4H := d3H
        d4L := d3L
        d3H := d2H
        d3L := d2L
        d2H := d1H
        d2L := d1L
        if not na(cH)
            d1H := cH
            d1L := cL
        cH := high
        cL := low
    else if not isWk and not inW
        cH := na(cH) ? high : math.max(cH, high)
        cL := na(cL) ? low  : math.min(cL, low)

    if isWk and not inW
        inW := true
        d4H := d3H
        d4L := d3L
        d3H := d2H
        d3L := d2L
        d2H := d1H
        d2L := d1L
        if not na(cH)
            d1H := cH
            d1L := cL
        cH := na
        cL := na
        if cmeC
            wH  := high
            wHT := time
            wL  := low
            wLT := time

    if isWk and inW and cmeC
        if na(wH)
            wH  := high
            wHT := time
            wL  := low
            wLT := time
        else
            if high > wH
                wH  := high
                wHT := time
            if low < wL
                wL  := low
                wLT := time

        bool h4 = not (na(d1H) or na(d2H) or na(d3H) or na(d4H))
        if h4 and not na(wH) and wH > d1H and wH > d2H and wH > d3H and wH > d4H
            rHP := wH
            rHT := wHT
        else
            rHP := na
            rHT := na
        if h4 and not na(wL) and wL < d1L and wL < d2L and wL < d3L and wL < d4L
            rLP := wL
            rLT := wLT
        else
            rLP := na
            rLT := na

    if not isWk and inW
        inW := false
        wH  := na
        wL  := na
        wHT := na
        wLT := na

    [rHP, rHT, rLP, rLT, isWk]

// ─────────────────────────────────────────────────────────────
// 1H FUNCTION: RAW WEEKEND HIGH/LOW (drawing)
//
// The chart symbol's own weekend extremes over the same cmeC window, with
// no qualification test. This is what the line is drawn at, so it sits on
// the wick you can actually see instead of floating off by CME basis.
// Values persist after the weekend so promotion and catch-up can read them.
// ─────────────────────────────────────────────────────────────

f_weekendRawHL() =>
    int  dow  = dayofweek(time, "America/Chicago")
    int  hr   = hour(time,      "America/Chicago")
    bool cmeC = (dow == 6 and hr >= 16) or dow == 7 or (dow == 1 and hr < 17)
    bool isWk = dayofweek(time, "UTC") == 7 or dayofweek(time, "UTC") == 1

    var bool  inW = false
    var float wH  = na
    var int   wHT = na
    var float wL  = na
    var int   wLT = na

    if isWk and not inW
        inW := true
        if cmeC
            wH  := high
            wHT := time
            wL  := low
            wLT := time

    if isWk and inW and cmeC
        if na(wH)
            wH  := high
            wHT := time
            wL  := low
            wLT := time
        else
            if high > wH
                wH  := high
                wHT := time
            if low < wL
                wL  := low
                wLT := time

    if not isWk and inW
        inW := false

    [wH, wHT, wL, wLT]

// ─────────────────────────────────────────────────────────────
// 1H FUNCTION: WEEKLY OPEN
//
// Fires on the first 1H bar each week where postWklyOpen flips true
// (Sun >= 19:00 CT). That bar's open is the weekly open price.
// ─────────────────────────────────────────────────────────────

f_weeklyOpen() =>
    int dow = dayofweek(time, "America/Chicago")
    int hr  = hour(time,      "America/Chicago")

    bool postWklyOpen = (dow == 1 and hr >= 19) or dow >= 2

    var bool  prevPost  = false
    var float wkOpen    = na
    var int   wkOpenT   = na
    var int   wkOpenAnc = na

    if postWklyOpen and not prevPost
        wkOpen    := open
        wkOpenT   := time
        wkOpenAnc := time

    prevPost := postWklyOpen
    [wkOpen, wkOpenT, wkOpenAnc]

// ─────────────────────────────────────────────────────────────
// 1H FUNCTION: PERIOD OPENS
//
// Daily / monthly / quarterly / yearly boundaries on UTC, each returning
// the boundary open price and its timestamp.
// ─────────────────────────────────────────────────────────────

f_periodLevels() =>
    int mo = month(time)
    int yr = year(time)

    // ── Daily ──
    bool newDay = ta.change(time("D")) != 0
    var float pDO = na, var int pDA = na
    if newDay
        pDO := open
        pDA := time
    else if na(pDO)
        pDO := open
        pDA := time

    // ── Monthly ──
    var int prevMo = -1
    bool newMonth = prevMo != -1 and mo != prevMo
    var float pMO = na, var int pMA = na
    if newMonth
        pMO := open
        pMA := time
    else if prevMo == -1
        pMO := open
        pMA := time
    prevMo := mo

    // ── Quarterly ──
    int qtr = int(math.ceil(mo / 3.0))
    var int prevQtr = -1
    bool newQtr = prevQtr != -1 and qtr != prevQtr
    var float pQO = na, var int pQA = na
    if newQtr
        pQO := open
        pQA := time
    else if prevQtr == -1
        pQO := open
        pQA := time
    prevQtr := qtr

    // ── Yearly ──
    var int prevYr = -1
    bool newYear = prevYr != -1 and yr != prevYr
    var float pYO = na, var int pYA = na
    if newYear
        pYO := open
        pYA := time
    else if prevYr == -1
        pYO := open
        pYA := time
    prevYr := yr

    [pDO, pDA, pMO, pMA, pQO, pQA, pYO, pYA]

// ─────────────────────────────────────────────────────────────
// SECURITY REQUESTS
// ─────────────────────────────────────────────────────────────

string extTicker = extSource == "CME" ? cmeSymbol : syminfo.tickerid
bool   extIsAlt  = extTicker != syminfo.tickerid
string srcTag    = (showSrcTag and extIsAlt) ? " (CME)" : ""
string srcName   = extIsAlt ? "CME" : syminfo.ticker

// Qualification + sweep authority: the validation venue.
[h1HighP, h1HighT, h1LowP, h1LowT, h1IsWk] = request.security(
    extTicker, "60", f_weekendExtremes(), gaps=barmerge.gaps_off)

// Sweep comparison prices, in the validation venue's own scale.
[srcHigh, srcLow] = request.security(
    extTicker, timeframe.period, [high, low], gaps=barmerge.gaps_off)

// Drawing prices + wick times: the chart symbol's own weekend extremes.
[drawHighP, drawHighT, drawLowP, drawLowT] = request.security(
    syminfo.tickerid, "60", f_weekendRawHL(), gaps=barmerge.gaps_off)

[h1WkOpenP, h1WkOpenT, h1WkOpenAnc] = request.security(
    syminfo.tickerid, "60", f_weeklyOpen(), gaps=barmerge.gaps_off)

[h1DO, h1DA, h1MO, h1MA, h1QO, h1QA, h1YO, h1YA] = request.security(
    syminfo.tickerid, "60", f_periodLevels(), gaps=barmerge.gaps_off)

// ─────────────────────────────────────────────────────────────
// LEVEL STORAGE — Permanent Weekend Extremes
//
// lvlPrice  = validation-venue price (sweep comparisons)
// lvlDrawP  = chart-symbol price (what gets drawn)
// ─────────────────────────────────────────────────────────────

var float[] lvlPrice  = array.new_float(0)
var float[] lvlDrawP  = array.new_float(0)
var int[]   lvlType   = array.new_int(0)
var int[]   lvlBar    = array.new_int(0)
var int[]   lvlBarIdx = array.new_int(0)
var line[]  lvlLines  = array.new_line(0)
var label[] lvlLabels = array.new_label(0)

// ─────────────────────────────────────────────────────────────
// PREVIEW STATE — Live weekend extremes
// ─────────────────────────────────────────────────────────────

var float previewHighP      = na   // validation venue — sweep tests
var float previewHighDrawP  = na   // chart symbol — drawing
var int   previewHighT      = na
var int   previewHighBarIdx = na
var bool  previewHighSwept  = false
var line  previewHighLine   = na
var label previewHighLabel  = na

var float previewLowP       = na
var float previewLowDrawP   = na
var int   previewLowT       = na
var int   previewLowBarIdx  = na
var bool  previewLowSwept   = false
var line  previewLowLine    = na
var label previewLowLabel   = na

// ─────────────────────────────────────────────────────────────
// LEVEL STATE — Weekly Open
// ─────────────────────────────────────────────────────────────

var float wkOpenP      = na
var int   wkOpenT      = na
var int   wkOpenBarIdx = na
var line  wkOpenLine   = na
var label wkOpenLabel  = na

// ─────────────────────────────────────────────────────────────
// LEVEL STATE — Period Opens
// ─────────────────────────────────────────────────────────────

var float dOpenP = na, var int dOpenBI = na, var line dOpenLn = na, var label dOpenLb = na
var float mOpenP = na, var int mOpenBI = na, var line mOpenLn = na, var label mOpenLb = na
var float qOpenP = na, var int qOpenBI = na, var line qOpenLn = na, var label qOpenLb = na
var float yOpenP = na, var int yOpenBI = na, var line yOpenLn = na, var label yOpenLb = na

// ─────────────────────────────────────────────────────────────
// WEEKEND TRANSITION DETECTION
// ─────────────────────────────────────────────────────────────

var bool prevWkActive = false
bool weekendStarted = h1IsWk and not prevWkActive
bool weekendEnded   = not h1IsWk and prevWkActive
prevWkActive := h1IsWk

if weekendStarted
    previewHighSwept := false
    previewLowSwept  := false

// Times of extremes already promoted or swept, so the catch-up path
// below doesn't re-emit what the preview path already handled.
var int lastEmittedHighT = -1
var int lastEmittedLowT  = -1

// ─────────────────────────────────────────────────────────────
// WEEKLY OPEN EMISSION
// ─────────────────────────────────────────────────────────────

var int lastWkOpenAnc = -1
bool newWkOpenEmit = showWkOpen and isBTC and not na(h1WkOpenAnc) and h1WkOpenAnc != lastWkOpenAnc

if newWkOpenEmit
    lastWkOpenAnc := h1WkOpenAnc
    wkOpenP       := h1WkOpenP
    wkOpenT       := h1WkOpenT
    wkOpenBarIdx  := f_anchorBI(h1WkOpenT)

// ─────────────────────────────────────────────────────────────
// PERIOD OPEN EMISSIONS
// ─────────────────────────────────────────────────────────────

var int lastDA = -1
if not na(h1DA) and h1DA != lastDA
    lastDA  := h1DA
    dOpenP  := h1DO
    dOpenBI := f_anchorBI(h1DA)

var int lastMA = -1
if not na(h1MA) and h1MA != lastMA
    lastMA  := h1MA
    mOpenP  := h1MO
    mOpenBI := f_anchorBI(h1MA)

var int lastQA = -1
if not na(h1QA) and h1QA != lastQA
    lastQA  := h1QA
    qOpenP  := h1QO
    qOpenBI := f_anchorBI(h1QA)

var int lastYA = -1
if not na(h1YA) and h1YA != lastYA
    lastYA  := h1YA
    yOpenP  := h1YO
    yOpenBI := f_anchorBI(h1YA)

// ─────────────────────────────────────────────────────────────
// PREVIEW UPDATE (during weekend)
//
// Qualification and sweep tests run on the validation venue. The drawn
// price and anchor come from the chart symbol's own wick, falling back to
// the validation price only if the chart feed has no value.
// ─────────────────────────────────────────────────────────────

var bool sweepHighFired = false
var bool sweepLowFired  = false
sweepHighFired := false
sweepLowFired  := false

if isBTC and h1IsWk
    if not previewHighSwept
        if not na(h1HighP) and not na(h1HighT)
            previewHighP     := h1HighP
            previewHighT     := h1HighT
            previewHighDrawP := na(drawHighP) ? h1HighP : drawHighP
            previewHighBarIdx := f_anchorBI(na(drawHighT) ? h1HighT : drawHighT)
        else
            previewHighP      := na
            previewHighDrawP  := na
            previewHighT      := na
            previewHighBarIdx := na

    if not previewHighSwept and not na(previewHighP) and not na(srcHigh) and srcHigh > previewHighP
        previewHighSwept  := true
        sweepHighFired    := true
        lastEmittedHighT  := previewHighT
        previewHighP      := na
        previewHighDrawP  := na
        previewHighT      := na
        previewHighBarIdx := na

    if not previewLowSwept
        if not na(h1LowP) and not na(h1LowT)
            previewLowP     := h1LowP
            previewLowT     := h1LowT
            previewLowDrawP := na(drawLowP) ? h1LowP : drawLowP
            previewLowBarIdx := f_anchorBI(na(drawLowT) ? h1LowT : drawLowT)
        else
            previewLowP      := na
            previewLowDrawP  := na
            previewLowT      := na
            previewLowBarIdx := na

    if not previewLowSwept and not na(previewLowP) and not na(srcLow) and srcLow < previewLowP
        previewLowSwept  := true
        sweepLowFired    := true
        lastEmittedLowT  := previewLowT
        previewLowP      := na
        previewLowDrawP  := na
        previewLowT      := na
        previewLowBarIdx := na

// ─────────────────────────────────────────────────────────────
// PROMOTION ON WEEKEND EXIT
// ─────────────────────────────────────────────────────────────

if weekendEnded and isBTC
    if not previewHighSwept and not na(previewHighP) and not na(previewHighT) and not na(previewHighBarIdx)
        array.push(lvlPrice,  previewHighP)
        array.push(lvlDrawP,  na(previewHighDrawP) ? previewHighP : previewHighDrawP)
        array.push(lvlType,   1)
        array.push(lvlBar,    previewHighT)
        array.push(lvlBarIdx, previewHighBarIdx)
        array.push(lvlLines,  line(na))
        array.push(lvlLabels, label(na))
        lastEmittedHighT := previewHighT

    if not previewLowSwept and not na(previewLowP) and not na(previewLowT) and not na(previewLowBarIdx)
        array.push(lvlPrice,  previewLowP)
        array.push(lvlDrawP,  na(previewLowDrawP) ? previewLowP : previewLowDrawP)
        array.push(lvlType,   -1)
        array.push(lvlBar,    previewLowT)
        array.push(lvlBarIdx, previewLowBarIdx)
        array.push(lvlLines,  line(na))
        array.push(lvlLabels, label(na))
        lastEmittedLowT := previewLowT

    line.delete(previewHighLine)
    label.delete(previewHighLabel)
    line.delete(previewLowLine)
    label.delete(previewLowLabel)
    previewHighLine   := na
    previewHighLabel  := na
    previewLowLine    := na
    previewLowLabel   := na
    previewHighP      := na
    previewHighDrawP  := na
    previewHighT      := na
    previewHighBarIdx := na
    previewLowP       := na
    previewLowDrawP   := na
    previewLowT       := na
    previewLowBarIdx  := na

// ─────────────────────────────────────────────────────────────
// CATCH-UP EMISSION
//
// LTF charts (1m–30m) often hold no weekend bars at all, so h1IsWk never
// transitions true→false on a visible bar and the promotion path never
// runs. This emits any qualified extreme the preview path hasn't handled.
// ─────────────────────────────────────────────────────────────

if isBTC and not h1IsWk
    if not na(h1HighT) and h1HighT != lastEmittedHighT
        lastEmittedHighT := h1HighT
        array.push(lvlPrice,  h1HighP)
        array.push(lvlDrawP,  na(drawHighP) ? h1HighP : drawHighP)
        array.push(lvlType,   1)
        array.push(lvlBar,    h1HighT)
        array.push(lvlBarIdx, f_anchorBI(na(drawHighT) ? h1HighT : drawHighT))
        array.push(lvlLines,  line(na))
        array.push(lvlLabels, label(na))

    if not na(h1LowT) and h1LowT != lastEmittedLowT
        lastEmittedLowT := h1LowT
        array.push(lvlPrice,  h1LowP)
        array.push(lvlDrawP,  na(drawLowP) ? h1LowP : drawLowP)
        array.push(lvlType,   -1)
        array.push(lvlBar,    h1LowT)
        array.push(lvlBarIdx, f_anchorBI(na(drawLowT) ? h1LowT : drawLowT))
        array.push(lvlLines,  line(na))
        array.push(lvlLabels, label(na))

// ─────────────────────────────────────────────────────────────
// SWEEP / STALE — Permanent Weekend Extremes
//
// Sweep is judged on the validation venue's price, never the chart's.
// ─────────────────────────────────────────────────────────────

if array.size(lvlPrice) > 0
    for j = array.size(lvlPrice) - 1 to 0
        float p       = array.get(lvlPrice, j)
        int   t       = array.get(lvlType,  j)
        int   lvlTime = array.get(lvlBar,   j)
        bool  swept   = (t == 1 and not na(srcHigh) and srcHigh > p) or (t == -1 and not na(srcLow) and srcLow < p)
        bool  stale   = (time - lvlTime) > extStaleMs

        if swept
            if t == 1
                sweepHighFired := true
            else
                sweepLowFired := true

        if swept or stale
            line.delete( array.get(lvlLines,  j))
            label.delete(array.get(lvlLabels, j))
            array.remove(lvlPrice,  j)
            array.remove(lvlDrawP,  j)
            array.remove(lvlType,   j)
            array.remove(lvlBar,    j)
            array.remove(lvlBarIdx, j)
            array.remove(lvlLines,  j)
            array.remove(lvlLabels, j)

while array.size(lvlPrice) > maxExtLevels
    line.delete( array.get(lvlLines,  0))
    label.delete(array.get(lvlLabels, 0))
    array.shift(lvlPrice)
    array.shift(lvlDrawP)
    array.shift(lvlType)
    array.shift(lvlBar)
    array.shift(lvlBarIdx)
    array.shift(lvlLines)
    array.shift(lvlLabels)

// ─────────────────────────────────────────────────────────────
// REMOVE — Weekly Open on Friday CME close
// ─────────────────────────────────────────────────────────────

if fridayCloseFired and not na(wkOpenP)
    wkOpenP      := na
    wkOpenT      := na
    wkOpenBarIdx := na

// ─────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────

if alertOnSweep and sweepHighFired
    alert("Weekend High swept on " + srcName + " | chart " + syminfo.ticker + " | " + str.tostring(close, "#.##"), alert.freq_once_per_bar)

if alertOnSweep and sweepLowFired
    alert("Weekend Low swept on " + srcName + " | chart " + syminfo.ticker + " | " + str.tostring(close, "#.##"), alert.freq_once_per_bar)

alertcondition(sweepHighFired, "Weekend High Swept", "Weekend High swept")
alertcondition(sweepLowFired,  "Weekend Low Swept",  "Weekend Low swept")

// ─────────────────────────────────────────────────────────────
// DRAW — Weekend Extreme Preview (live during weekend)
// ─────────────────────────────────────────────────────────────

line.delete(previewHighLine)
label.delete(previewHighLabel)
line.delete(previewLowLine)
label.delete(previewLowLabel)
previewHighLine  := na
previewHighLabel := na
previewLowLine   := na
previewLowLabel  := na

if showExt and h1IsWk and isBTC
    if not na(previewHighDrawP) and not na(previewHighBarIdx)
        int prevHX1 = f_safeBI(previewHighBarIdx)
        int prevHX2 = math.max(bar_index, prevHX1 + 1)
        previewHighLine := line.new(
             prevHX1, previewHighDrawP, prevHX2, previewHighDrawP,
             color=highColor, width=lineWidth,
             style=getLineStyle(lineStyle),
             extend=extend.right, xloc=xloc.bar_index)
        if showLabels
            previewHighLabel := label.new(
                 bar_index, previewHighDrawP, "Weekend High" + srcTag,
                 color=color.new(color.black, 100), textcolor=highColor,
                 style=label.style_label_lower_left,
                 size=size.small, xloc=xloc.bar_index)

    if not na(previewLowDrawP) and not na(previewLowBarIdx)
        int prevLX1 = f_safeBI(previewLowBarIdx)
        int prevLX2 = math.max(bar_index, prevLX1 + 1)
        previewLowLine := line.new(
             prevLX1, previewLowDrawP, prevLX2, previewLowDrawP,
             color=lowColor, width=lineWidth,
             style=getLineStyle(lineStyle),
             extend=extend.right, xloc=xloc.bar_index)
        if showLabels
            previewLowLabel := label.new(
                 bar_index, previewLowDrawP, "Weekend Low" + srcTag,
                 color=color.new(color.black, 100), textcolor=lowColor,
                 style=label.style_label_upper_left,
                 size=size.small, xloc=xloc.bar_index)

// ─────────────────────────────────────────────────────────────
// DRAW — Permanent Weekend Extremes
// ─────────────────────────────────────────────────────────────

if array.size(lvlPrice) > 0
    for j = 0 to array.size(lvlPrice) - 1
        float dp     = array.get(lvlDrawP,  j)
        int   t      = array.get(lvlType,   j)
        int   startI = array.get(lvlBarIdx, j)
        color col    = t == 1 ? highColor : lowColor

        line.delete( array.get(lvlLines,  j))
        label.delete(array.get(lvlLabels, j))

        if showExt and not na(dp)
            int extX1 = f_safeBI(startI)
            int extX2 = math.max(bar_index, extX1 + 1)
            array.set(lvlLines, j, line.new(
                 extX1, dp, extX2, dp,
                 color=col, width=lineWidth,
                 style=getLineStyle(lineStyle),
                 extend=extend.right, xloc=xloc.bar_index))

            if showLabels
                string lbl = (t == 1 ? "Weekend High" : "Weekend Low") + srcTag
                array.set(lvlLabels, j, label.new(
                     bar_index, dp, lbl,
                     color=color.new(color.black, 100), textcolor=col,
                     style=t == 1 ? label.style_label_lower_left : label.style_label_upper_left,
                     size=size.small, xloc=xloc.bar_index))

// ─────────────────────────────────────────────────────────────
// MERGE — Coincident Period Opens
//
// At a shared boundary (new year → Y/Q/M/W/D opens coincide) only the
// most significant level draws. Priority high→low: Y > Q > M > W > D.
// A level is suppressed when a higher-priority enabled level shares its
// price (to mintick) or its anchor bar.
// ─────────────────────────────────────────────────────────────

f_samePrice(float a, float b) =>
    not na(a) and not na(b) and math.round(a / syminfo.mintick) == math.round(b / syminfo.mintick)

f_sameAnchor(int a, int b) =>
    not na(a) and not na(b) and a == b

f_merge(float pa, float pb, int aa, int ab) =>
    f_samePrice(pa, pb) or f_sameAnchor(aa, ab)

bool yOn = showYearOpen  and not na(yOpenP)
bool qOn = showQtrOpen   and not na(qOpenP)
bool mOn = showMonthOpen and not na(mOpenP)
bool wOn = showWkOpen    and not na(wkOpenP)
bool dOn = showDailyOpen and not na(dOpenP)

bool qHid = qOn and yOn and f_merge(qOpenP, yOpenP, qOpenBI, yOpenBI)
bool mHid = mOn and ((yOn and f_merge(mOpenP, yOpenP, mOpenBI, yOpenBI)) or (qOn and f_merge(mOpenP, qOpenP, mOpenBI, qOpenBI)))
bool wHid = wOn and ((yOn and f_merge(wkOpenP, yOpenP, wkOpenBarIdx, yOpenBI)) or (qOn and f_merge(wkOpenP, qOpenP, wkOpenBarIdx, qOpenBI)) or (mOn and f_merge(wkOpenP, mOpenP, wkOpenBarIdx, mOpenBI)))
bool dHid = dOn and ((yOn and f_merge(dOpenP, yOpenP, dOpenBI, yOpenBI)) or (qOn and f_merge(dOpenP, qOpenP, dOpenBI, qOpenBI)) or (mOn and f_merge(dOpenP, mOpenP, dOpenBI, mOpenBI)) or (wOn and f_merge(dOpenP, wkOpenP, dOpenBI, wkOpenBarIdx)))

bool drawY = showYearOpen
bool drawQ = showQtrOpen   and not qHid
bool drawM = showMonthOpen and not mHid
bool drawW = showWkOpen    and not wHid
bool drawD = showDailyOpen and not dHid

// Absorbed tags append to the surviving level's label.
string yTxt = "yO"
string qTxt = "qO"
string mTxt = "mO"
string wTxt = "wO"
string dTxt = "dO"

if qOn and qHid
    yTxt += "/qO"

if mOn and mHid
    if yOn and drawY and f_merge(mOpenP, yOpenP, mOpenBI, yOpenBI)
        yTxt += "/mO"
    else if qOn and drawQ and f_merge(mOpenP, qOpenP, mOpenBI, qOpenBI)
        qTxt += "/mO"

if wOn and wHid
    if yOn and drawY and f_merge(wkOpenP, yOpenP, wkOpenBarIdx, yOpenBI)
        yTxt += "/wO"
    else if qOn and drawQ and f_merge(wkOpenP, qOpenP, wkOpenBarIdx, qOpenBI)
        qTxt += "/wO"
    else if mOn and drawM and f_merge(wkOpenP, mOpenP, wkOpenBarIdx, mOpenBI)
        mTxt += "/wO"

if dOn and dHid
    if yOn and drawY and f_merge(dOpenP, yOpenP, dOpenBI, yOpenBI)
        yTxt += "/dO"
    else if qOn and drawQ and f_merge(dOpenP, qOpenP, dOpenBI, qOpenBI)
        qTxt += "/dO"
    else if mOn and drawM and f_merge(dOpenP, mOpenP, dOpenBI, mOpenBI)
        mTxt += "/dO"
    else if wOn and drawW and f_merge(dOpenP, wkOpenP, dOpenBI, wkOpenBarIdx)
        wTxt += "/dO"

// ─────────────────────────────────────────────────────────────
// DRAW — Weekly Open
// ─────────────────────────────────────────────────────────────

line.delete(wkOpenLine)
label.delete(wkOpenLabel)
wkOpenLine  := na
wkOpenLabel := na

if drawW and not na(wkOpenP) and not na(wkOpenBarIdx)
    int drawX1 = f_safeBI(wkOpenBarIdx)
    int drawX2 = math.max(bar_index, drawX1 + 1)
    wkOpenLine := line.new(
         drawX1, wkOpenP, drawX2, wkOpenP,
         color=wkOpenColor, width=wkOpenLineWidth,
         style=getLineStyle(wkOpenStyle),
         extend=extend.right, xloc=xloc.bar_index)
    if showLabels
        wkOpenLabel := label.new(
             bar_index, wkOpenP, wTxt,
             color=color.new(color.black, 100), textcolor=wkOpenColor,
             style=close < wkOpenP ? label.style_label_lower_left : label.style_label_upper_left,
             size=size.small, xloc=xloc.bar_index)

// ─────────────────────────────────────────────────────────────
// DRAW — Daily / Monthly / Quarterly / Yearly Opens
// ─────────────────────────────────────────────────────────────

[n1, n2] = f_drawPeriodLevel(dOpenLn, dOpenLb, drawD, dOpenP, dOpenBI, dailyColor, dailyWidth, getLineStyle(dOpenStyle), dTxt)
dOpenLn := n1
dOpenLb := n2
[n3, n4] = f_drawPeriodLevel(mOpenLn, mOpenLb, drawM, mOpenP, mOpenBI, monthColor, monthWidth, getLineStyle(mOpenStyle), mTxt)
mOpenLn := n3
mOpenLb := n4
[n5, n6] = f_drawPeriodLevel(qOpenLn, qOpenLb, drawQ, qOpenP, qOpenBI, qtrColor, qtrWidth, getLineStyle(qOpenStyle), qTxt)
qOpenLn := n5
qOpenLb := n6
[n7, n8] = f_drawPeriodLevel(yOpenLn, yOpenLb, drawY, yOpenP, yOpenBI, yearColor, yearWidth, getLineStyle(yOpenStyle), yTxt)
yOpenLn := n7
yOpenLb := n8

plot(na)
