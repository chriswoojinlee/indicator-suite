//@version=6
indicator(title="VWAP", shorttitle="VWAP", overlay=true, max_lines_count=500, max_labels_count=100)

// ———————————————————— Exchange Data {

rawTicker = syminfo.ticker
baseSymbol = str.replace(str.replace(str.replace(str.replace(str.replace(rawTicker, "USDT", ""), "USDC", ""), "USD", ""), "PERP", ""), ".P", "")

[bsPrice, bsVol] = request.security("BINANCE:" + baseSymbol + "USDT", timeframe.period, [hlc3, volume], ignore_invalid_symbol=true)
[cbPrice, cbVol] = request.security("COINBASE:" + baseSymbol + "USD", timeframe.period, [hlc3, volume], ignore_invalid_symbol=true)
[krPrice, krVol] = request.security("KRAKEN:" + baseSymbol + "USD", timeframe.period, [hlc3, volume], ignore_invalid_symbol=true)
[bpPrice, bpVol] = request.security("BINANCE:" + baseSymbol + "USDT.P", timeframe.period, [hlc3, volume], ignore_invalid_symbol=true)
[byPrice, byVol] = request.security("BYBIT:" + baseSymbol + "USDT.P", timeframe.period, [hlc3, volume], ignore_invalid_symbol=true)
[okPrice, okVol] = request.security("OKX:" + baseSymbol + "USDT.P", timeframe.period, [hlc3, volume], ignore_invalid_symbol=true)

totalVol = nz(bsVol) + nz(cbVol) + nz(krVol) + nz(bpVol) + nz(byVol) + nz(okVol)
totalPV = nz(bsPrice * bsVol) + nz(cbPrice * cbVol) + nz(krPrice * krVol) + 
          nz(bpPrice * bpVol) + nz(byPrice * byVol) + nz(okPrice * okVol)

combinedPrice = totalVol > 0 ? totalPV / totalVol : hlc3

// ———————————————————— Inputs {

autoAnchor = timeframe.in_seconds() < 3600 ? "Week" : timeframe.in_seconds() <= 14400 ? "Month" : timeframe.in_seconds() <= 43200 ? "Quarter" : "Year"

var anchor = input.string(defval = "Auto", title="Anchor Period",
 options=["Auto", "Session", "Week", "Month", "Quarter", "Year", "Decade", "Century", "Earnings", "Dividends", "Splits"], group="VWAP Settings", display = display.none)

actualAnchor = anchor == "Auto" ? autoAnchor : anchor

BANDS_GROUP = "Bands Settings"
showBand_1 = input.bool(true, "Band 1", group = BANDS_GROUP, display = display.none)
showBand_2 = input.bool(false, "Band 2", group = BANDS_GROUP, display = display.none)
showBand_3 = input.bool(false, "Band 3", group = BANDS_GROUP, display = display.none)
bandLineColor = input.color(color.new(color.white, 100), "Line", inline = "bandcolor", group = BANDS_GROUP, display = display.none)
bandFillColor = input.color(color.new(color.white, 85), "Fill", inline = "bandcolor", group = BANDS_GROUP, display = display.none)

PREV_GROUP = "Previous Period Settings"
showPrevPeriod = input.bool(true, "Show Previous VWAP", group = PREV_GROUP, display = display.none)
showPrevBand_1 = input.bool(true, "Band 1", group = PREV_GROUP, display = display.none)
showPrevBand_2 = input.bool(false, "Band 2", group = PREV_GROUP, display = display.none)
showPrevBand_3 = input.bool(false, "Band 3", group = PREV_GROUP, display = display.none)
prevBandLineColor = input.color(color.new(color.white, 100), "Line", inline = "pbandcolor", group = PREV_GROUP, display = display.none)
prevBandFillColor = input.color(color.new(color.white, 85), "Fill", inline = "pbandcolor", group = PREV_GROUP, display = display.none)

// Historical extended periods
HIST_GROUP = "Historical Periods"
histPeriods      = input.int(0, "Number of Extended Periods", minval=0, maxval=5, group=HIST_GROUP, display=display.none, tooltip="How many older VWAP periods to extend forward. 0 = disabled. Uses the same style settings as Previous Period.")

// Manual period merging
MERGE_GROUP = "Merge Periods"
mergePeriods = input.int(0, "Merge Last N Completed Periods", minval=0, maxval=8, group=MERGE_GROUP, display=display.none, tooltip="Recomputes a single volume-weighted VWAP + SD bands over the last N completed periods. 0 or 1 alone = disabled. Suppresses the individual previous-period and covered historical drawings while active.")
mergeIncludeCurrent = input.bool(false, "Include Current Period", group=MERGE_GROUP, display=display.none, tooltip="Adds the developing current period's volume into the merged calculation.")

mergeActive = mergePeriods >= 2 or (mergePeriods >= 1 and mergeIncludeCurrent)

// ———————————————————— Period Detection {

new_earnings = request.earnings(syminfo.tickerid, earnings.actual, barmerge.gaps_on, barmerge.lookahead_on, ignore_invalid_symbol=true)
new_dividends = request.dividends(syminfo.tickerid, dividends.gross, barmerge.gaps_on, barmerge.lookahead_on, ignore_invalid_symbol=true)
new_split = request.splits(syminfo.tickerid, splits.denominator, barmerge.gaps_on, barmerge.lookahead_on, ignore_invalid_symbol=true)

isNewPeriod = switch actualAnchor
	"Earnings"  => not na(new_earnings)
	"Dividends" => not na(new_dividends)
	"Splits"    => not na(new_split)
	"Session"   => timeframe.change("D")
	"Week"      => timeframe.change("W")
	"Month"     => timeframe.change("M")
	"Quarter"   => timeframe.change("3M")
	"Year"      => timeframe.change("12M")
	"Decade"    => timeframe.change("12M") and year % 10 == 0
	"Century"   => timeframe.change("12M") and year % 100 == 0
	=> false

isEsdAnchor = actualAnchor == "Earnings" or actualAnchor == "Dividends" or actualAnchor == "Splits"
if na(combinedPrice[1]) and not isEsdAnchor
	isNewPeriod := true

// ———————————————————— Per-Period Volume Sums (for merging) {
// Running sums reset each period; completed periods pushed to arrays.
// Merged VWAP  = ΣPV / ΣV across merged periods
// Merged stdev = sqrt(ΣP²V / ΣV − vwap²)

var float cumVol = 0.0
var float cumPV  = 0.0
var float cumPV2 = 0.0
var int   periodStartBar = 0

var array<float> sumVolArr   = array.new_float()
var array<float> sumPVArr    = array.new_float()
var array<float> sumPV2Arr   = array.new_float()
var array<int>   startBarArr = array.new_int()
int MAX_SUM_STORE = 10

if isNewPeriod
    if cumVol > 0
        array.push(sumVolArr,   cumVol)
        array.push(sumPVArr,    cumPV)
        array.push(sumPV2Arr,   cumPV2)
        array.push(startBarArr, periodStartBar)
        while array.size(sumVolArr) > MAX_SUM_STORE
            array.shift(sumVolArr)
            array.shift(sumPVArr)
            array.shift(sumPV2Arr)
            array.shift(startBarArr)
    cumVol := 0.0
    cumPV  := 0.0
    cumPV2 := 0.0
    periodStartBar := bar_index

cumVol += totalVol
cumPV  += combinedPrice * totalVol
cumPV2 += combinedPrice * combinedPrice * totalVol

// ———————————————————— VWAP Calculation {

[_vwap, _stdevUpper, _] = ta.vwap(combinedPrice, isNewPeriod, 1)
float vwapValue = _vwap
float stdevAbs = _stdevUpper - _vwap

float upperBand1 = _vwap + stdevAbs
float lowerBand1 = _vwap - stdevAbs
float upperBand2 = _vwap + stdevAbs * 2
float lowerBand2 = _vwap - stdevAbs * 2
float upperBand3 = _vwap + stdevAbs * 3
float lowerBand3 = _vwap - stdevAbs * 3

// ———————————————————— Previous Period Storage {

var float prevVwap = na
var float prevUpper1 = na, var float prevLower1 = na
var float prevUpper2 = na, var float prevLower2 = na
var float prevUpper3 = na, var float prevLower3 = na

// ———————————————————— Historical Period Storage {

var array<float> histVwapArr   = array.new_float()
var array<float> histUpper1Arr = array.new_float()
var array<float> histLower1Arr = array.new_float()
var array<float> histUpper2Arr = array.new_float()
var array<float> histLower2Arr = array.new_float()
var array<float> histUpper3Arr = array.new_float()
var array<float> histLower3Arr = array.new_float()
var array<int>   histBarArr    = array.new_int()

var array<line>     histLines = array.new_line()
var array<linefill> histFills = array.new_linefill()

if isNewPeriod and not na(vwapValue[1])
    if not na(prevVwap) and histPeriods > 0
        array.push(histVwapArr,   prevVwap)
        array.push(histUpper1Arr, prevUpper1)
        array.push(histLower1Arr, prevLower1)
        array.push(histUpper2Arr, prevUpper2)
        array.push(histLower2Arr, prevLower2)
        array.push(histUpper3Arr, prevUpper3)
        array.push(histLower3Arr, prevLower3)
        array.push(histBarArr,    bar_index)

        while array.size(histVwapArr) > histPeriods
            array.shift(histVwapArr)
            array.shift(histUpper1Arr)
            array.shift(histLower1Arr)
            array.shift(histUpper2Arr)
            array.shift(histLower2Arr)
            array.shift(histUpper3Arr)
            array.shift(histLower3Arr)
            array.shift(histBarArr)

    prevVwap   := vwapValue[1]
    prevUpper1 := upperBand1[1]
    prevLower1 := lowerBand1[1]
    prevUpper2 := upperBand2[1]
    prevLower2 := lowerBand2[1]
    prevUpper3 := upperBand3[1]
    prevLower3 := lowerBand3[1]

// ———————————————————— Draw Historical Extensions {
// When merge is active, the newest (mergePeriods - 1) history entries are
// covered by the merged drawing and skipped here.

if barstate.islast and histPeriods > 0
    if array.size(histFills) > 0
        for i = 0 to array.size(histFills) - 1
            linefill.delete(array.get(histFills, i))
        array.clear(histFills)
    if array.size(histLines) > 0
        for i = 0 to array.size(histLines) - 1
            line.delete(array.get(histLines, i))
        array.clear(histLines)

    int skipNewest = mergeActive ? math.max(mergePeriods - 1, 0) : 0
    int sz = array.size(histVwapArr) - skipNewest
    if sz > 0
        for i = 0 to sz - 1
            float hVwap = array.get(histVwapArr, i)
            float hU1   = array.get(histUpper1Arr, i)
            float hL1   = array.get(histLower1Arr, i)
            float hU2   = array.get(histUpper2Arr, i)
            float hL2   = array.get(histLower2Arr, i)
            float hU3   = array.get(histUpper3Arr, i)
            float hL3   = array.get(histLower3Arr, i)
            int   hBar  = array.get(histBarArr, i)

            line vwapLine = line.new(hBar, hVwap, bar_index, hVwap, color=color.new(color.white, 25), style=line.style_dotted, width=2)
            array.push(histLines, vwapLine)

            if showPrevBand_1 and not na(hU1) and not na(hL1)
                line u1Line = line.new(hBar, hU1, bar_index, hU1, color=prevBandLineColor)
                line l1Line = line.new(hBar, hL1, bar_index, hL1, color=prevBandLineColor)
                array.push(histLines, u1Line)
                array.push(histLines, l1Line)
                linefill f1 = linefill.new(u1Line, l1Line, prevBandFillColor)
                array.push(histFills, f1)

            if showPrevBand_2 and not na(hU2) and not na(hL2) and not na(hU1) and not na(hL1)
                line u2Line = line.new(hBar, hU2, bar_index, hU2, color=prevBandLineColor)
                line l2Line = line.new(hBar, hL2, bar_index, hL2, color=prevBandLineColor)
                line u1Ref = line.new(hBar, hU1, bar_index, hU1, color=prevBandLineColor)
                line l1Ref = line.new(hBar, hL1, bar_index, hL1, color=prevBandLineColor)
                array.push(histLines, u2Line)
                array.push(histLines, l2Line)
                array.push(histLines, u1Ref)
                array.push(histLines, l1Ref)
                linefill f2u = linefill.new(u2Line, u1Ref, prevBandFillColor)
                linefill f2l = linefill.new(l1Ref, l2Line, prevBandFillColor)
                array.push(histFills, f2u)
                array.push(histFills, f2l)

            if showPrevBand_3 and not na(hU3) and not na(hL3) and not na(hU2) and not na(hL2)
                line u3Line = line.new(hBar, hU3, bar_index, hU3, color=prevBandLineColor)
                line l3Line = line.new(hBar, hL3, bar_index, hL3, color=prevBandLineColor)
                line u2Ref = line.new(hBar, hU2, bar_index, hU2, color=prevBandLineColor)
                line l2Ref = line.new(hBar, hL2, bar_index, hL2, color=prevBandLineColor)
                array.push(histLines, u3Line)
                array.push(histLines, l3Line)
                array.push(histLines, u2Ref)
                array.push(histLines, l2Ref)
                linefill f3u = linefill.new(u3Line, u2Ref, prevBandFillColor)
                linefill f3l = linefill.new(l2Ref, l3Line, prevBandFillColor)
                array.push(histFills, f3u)
                array.push(histFills, f3l)

// ———————————————————— Draw Merged Period {
// Volume-weighted recombination of the last N completed periods
// (optionally + current developing period). Drawn from the start bar
// of the oldest merged period.

var array<line>     mergeLines = array.new_line()
var array<linefill> mergeFills = array.new_linefill()

if barstate.islast
    if array.size(mergeFills) > 0
        for i = 0 to array.size(mergeFills) - 1
            linefill.delete(array.get(mergeFills, i))
        array.clear(mergeFills)
    if array.size(mergeLines) > 0
        for i = 0 to array.size(mergeLines) - 1
            line.delete(array.get(mergeLines, i))
        array.clear(mergeLines)

    int szs = array.size(sumVolArr)
    int nCompleted = math.min(mergePeriods, szs)
    if mergeActive and (nCompleted >= 1 or mergeIncludeCurrent)
        float mVol = 0.0
        float mPV  = 0.0
        float mPV2 = 0.0
        int   mStart = bar_index

        if nCompleted >= 1
            for i = szs - nCompleted to szs - 1
                mVol += array.get(sumVolArr, i)
                mPV  += array.get(sumPVArr, i)
                mPV2 += array.get(sumPV2Arr, i)
            mStart := array.get(startBarArr, szs - nCompleted)

        if mergeIncludeCurrent
            mVol += cumVol
            mPV  += cumPV
            mPV2 += cumPV2

        if mVol > 0
            float mVwap  = mPV / mVol
            float mVar   = math.max(mPV2 / mVol - mVwap * mVwap, 0.0)
            float mStdev = math.sqrt(mVar)

            line mv = line.new(mStart, mVwap, bar_index, mVwap, color=color.new(color.white, 25), style=line.style_dotted, width=2)
            array.push(mergeLines, mv)

            float mU1 = mVwap + mStdev,     mL1 = mVwap - mStdev
            float mU2 = mVwap + mStdev * 2, mL2 = mVwap - mStdev * 2
            float mU3 = mVwap + mStdev * 3, mL3 = mVwap - mStdev * 3

            if showPrevBand_1
                line u1 = line.new(mStart, mU1, bar_index, mU1, color=prevBandLineColor)
                line l1 = line.new(mStart, mL1, bar_index, mL1, color=prevBandLineColor)
                array.push(mergeLines, u1)
                array.push(mergeLines, l1)
                array.push(mergeFills, linefill.new(u1, l1, prevBandFillColor))

            if showPrevBand_2
                line u2 = line.new(mStart, mU2, bar_index, mU2, color=prevBandLineColor)
                line l2 = line.new(mStart, mL2, bar_index, mL2, color=prevBandLineColor)
                line u1r = line.new(mStart, mU1, bar_index, mU1, color=prevBandLineColor)
                line l1r = line.new(mStart, mL1, bar_index, mL1, color=prevBandLineColor)
                array.push(mergeLines, u2)
                array.push(mergeLines, l2)
                array.push(mergeLines, u1r)
                array.push(mergeLines, l1r)
                array.push(mergeFills, linefill.new(u2, u1r, prevBandFillColor))
                array.push(mergeFills, linefill.new(l1r, l2, prevBandFillColor))

            if showPrevBand_3
                line u3 = line.new(mStart, mU3, bar_index, mU3, color=prevBandLineColor)
                line l3 = line.new(mStart, mL3, bar_index, mL3, color=prevBandLineColor)
                line u2r = line.new(mStart, mU2, bar_index, mU2, color=prevBandLineColor)
                line l2r = line.new(mStart, mL2, bar_index, mL2, color=prevBandLineColor)
                array.push(mergeLines, u3)
                array.push(mergeLines, l3)
                array.push(mergeLines, u2r)
                array.push(mergeLines, l2r)
                array.push(mergeFills, linefill.new(u3, u2r, prevBandFillColor))
                array.push(mergeFills, linefill.new(l2r, l3, prevBandFillColor))

// ———————————————————— Plots - Current Period {

plot(vwapValue, title = "VWAP", color = color.new(color.white, 25), linewidth = 2)

p_upper1 = plot(showBand_1 ? upperBand1 : na, title="Upper Band 1", color = bandLineColor)
p_lower1 = plot(showBand_1 ? lowerBand1 : na, title="Lower Band 1", color = bandLineColor)
fill(p_upper1, p_lower1, title="Band 1 Fill", color = showBand_1 ? bandFillColor : na)

p_upper2 = plot(showBand_2 ? upperBand2 : na, title="Upper Band 2", color = bandLineColor)
p_lower2 = plot(showBand_2 ? lowerBand2 : na, title="Lower Band 2", color = bandLineColor)
fill(p_upper2, p_upper1, title="Band 2 Upper Fill", color = showBand_2 ? bandFillColor : na)
fill(p_lower1, p_lower2, title="Band 2 Lower Fill", color = showBand_2 ? bandFillColor : na)

p_upper3 = plot(showBand_3 ? upperBand3 : na, title="Upper Band 3", color = bandLineColor)
p_lower3 = plot(showBand_3 ? lowerBand3 : na, title="Lower Band 3", color = bandLineColor)
fill(p_upper3, p_upper2, title="Band 3 Upper Fill", color = showBand_3 ? bandFillColor : na)
fill(p_lower2, p_lower3, title="Band 3 Lower Fill", color = showBand_3 ? bandFillColor : na)

// ———————————————————— Plots - Previous Period {
// Suppressed while a merge is active (merge always covers the previous period).

showPrevEff = showPrevPeriod and not mergeActive

plot(showPrevEff ? prevVwap : na, title = "Previous VWAP", color = color.new(color.white, 25), linewidth = 2)

pp_upper1 = plot(showPrevEff and showPrevBand_1 ? prevUpper1 : na, title = "Prev Upper Band 1", color = prevBandLineColor)
pp_lower1 = plot(showPrevEff and showPrevBand_1 ? prevLower1 : na, title = "Prev Lower Band 1", color = prevBandLineColor)
fill(pp_upper1, pp_lower1, title = "Prev Band 1 Fill", color = showPrevEff and showPrevBand_1 ? prevBandFillColor : na)

pp_upper2 = plot(showPrevEff and showPrevBand_2 ? prevUpper2 : na, title = "Prev Upper Band 2", color = prevBandLineColor)
pp_lower2 = plot(showPrevEff and showPrevBand_2 ? prevLower2 : na, title = "Prev Lower Band 2", color = prevBandLineColor)
fill(pp_upper2, pp_upper1, title = "Prev Band 2 Upper Fill", color = showPrevEff and showPrevBand_2 ? prevBandFillColor : na)
fill(pp_lower1, pp_lower2, title = "Prev Band 2 Lower Fill", color = showPrevEff and showPrevBand_2 ? prevBandFillColor : na)

pp_upper3 = plot(showPrevEff and showPrevBand_3 ? prevUpper3 : na, title = "Prev Upper Band 3", color = prevBandLineColor)
pp_lower3 = plot(showPrevEff and showPrevBand_3 ? prevLower3 : na, title = "Prev Lower Band 3", color = prevBandLineColor)
fill(pp_upper3, pp_upper2, title = "Prev Band 3 Upper Fill", color = showPrevEff and showPrevBand_3 ? prevBandFillColor : na)
fill(pp_lower2, pp_lower3, title = "Prev Band 3 Lower Fill", color = showPrevEff and showPrevBand_3 ? prevBandFillColor : na)