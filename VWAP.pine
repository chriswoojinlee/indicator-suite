//@version=6
indicator(title="VWAP", shorttitle="VWAP", overlay=true, timeframe="", timeframe_gaps=true)

// ———————————————————— Exchange Data {

// Extract base symbol from current chart
rawTicker = syminfo.ticker
baseSymbol = str.replace(str.replace(str.replace(str.replace(str.replace(rawTicker, "USDT", ""), "USDC", ""), "USD", ""), "PERP", ""), ".P", "")

// Fetch all exchange data
[bsPrice, bsVol] = request.security("BINANCE:" + baseSymbol + "USDT", timeframe.period, [hlc3, volume], ignore_invalid_symbol=true)
[cbPrice, cbVol] = request.security("COINBASE:" + baseSymbol + "USD", timeframe.period, [hlc3, volume], ignore_invalid_symbol=true)
[krPrice, krVol] = request.security("KRAKEN:" + baseSymbol + "USD", timeframe.period, [hlc3, volume], ignore_invalid_symbol=true)
[bpPrice, bpVol] = request.security("BINANCE:" + baseSymbol + "USDT.P", timeframe.period, [hlc3, volume], ignore_invalid_symbol=true)
[byPrice, byVol] = request.security("BYBIT:" + baseSymbol + "USDT.P", timeframe.period, [hlc3, volume], ignore_invalid_symbol=true)
[okPrice, okVol] = request.security("OKX:" + baseSymbol + "USDT.P", timeframe.period, [hlc3, volume], ignore_invalid_symbol=true)

// Aggregate
totalVol = nz(bsVol) + nz(cbVol) + nz(krVol) + nz(bpVol) + nz(byVol) + nz(okVol)
totalPV = nz(bsPrice * bsVol) + nz(cbPrice * cbVol) + nz(krPrice * krVol) + 
          nz(bpPrice * bpVol) + nz(byPrice * byVol) + nz(okPrice * okVol)

combinedPrice = totalVol > 0 ? totalPV / totalVol : hlc3

// ———————————————————— Inputs {

// Anchor settings
autoAnchor = timeframe.in_seconds() < 3600 ? "Week" : timeframe.in_seconds() <= 14400 ? "Month" : timeframe.in_seconds() <= 43200 ? "Quarter" : "Year"

var anchor = input.string(defval = "Auto", title="Anchor Period",
 options=["Auto", "Session", "Week", "Month", "Quarter", "Year", "Decade", "Century", "Earnings", "Dividends", "Splits"], group="VWAP Settings", display = display.none)

actualAnchor = anchor == "Auto" ? autoAnchor : anchor

// Bands settings
BANDS_GROUP = "Bands Settings"
showBand_1 = input.bool(true, "Band 1", group = BANDS_GROUP, display = display.none)
showBand_2 = input.bool(false, "Band 2", group = BANDS_GROUP, display = display.none)
showBand_3 = input.bool(false, "Band 3", group = BANDS_GROUP, display = display.none)
bandLineColor = input.color(color.new(color.white, 100), "Line", inline = "bandcolor", group = BANDS_GROUP, display = display.none)
bandFillColor = input.color(color.new(color.white, 85), "Fill", inline = "bandcolor", group = BANDS_GROUP, display = display.none)

// Previous period settings
PREV_GROUP = "Previous Period Settings"
showPrevPeriod = input.bool(true, "Show Previous VWAP", group = PREV_GROUP, display = display.none)
showPrevBand_1 = input.bool(true, "Band 1", group = PREV_GROUP, display = display.none)
showPrevBand_2 = input.bool(false, "Band 2", group = PREV_GROUP, display = display.none)
showPrevBand_3 = input.bool(false, "Band 3", group = PREV_GROUP, display = display.none)
prevBandLineColor = input.color(color.new(color.white, 100), "Line", inline = "pbandcolor", group = PREV_GROUP, display = display.none)
prevBandFillColor = input.color(color.new(color.white, 85), "Fill", inline = "pbandcolor", group = PREV_GROUP, display = display.none)

// ———————————————————— Period Detection {

new_earnings = request.earnings(syminfo.tickerid, earnings.actual, barmerge.gaps_on, barmerge.lookahead_on, ignore_invalid_symbol=true)
new_dividends = request.dividends(syminfo.tickerid, dividends.gross, barmerge.gaps_on, barmerge.lookahead_on, ignore_invalid_symbol=true)
new_split = request.splits(syminfo.tickerid, splits.denominator, barmerge.gaps_on, barmerge.lookahead_on, ignore_invalid_symbol=true)

isNewPeriod = switch actualAnchor
	"Earnings"  => not na(new_earnings)
	"Dividends" => not na(new_dividends)
	"Splits"    => not na(new_split)
	"Session"   => timeframe.change("D")
	"Week"      => timeframe.change("W")
	"Month"     => timeframe.change("M")
	"Quarter"   => timeframe.change("3M")
	"Year"      => timeframe.change("12M")
	"Decade"    => timeframe.change("12M") and year % 10 == 0
	"Century"   => timeframe.change("12M") and year % 100 == 0
	=> false

isEsdAnchor = actualAnchor == "Earnings" or actualAnchor == "Dividends" or actualAnchor == "Splits"
if na(combinedPrice[1]) and not isEsdAnchor
	isNewPeriod := true

// ———————————————————— VWAP Calculation {

[_vwap, _stdevUpper, _] = ta.vwap(combinedPrice, isNewPeriod, 1)
float vwapValue = _vwap
float stdevAbs = _stdevUpper - _vwap

// Calculate band values (standard deviation mode, fixed multipliers)
float upperBand1 = _vwap + stdevAbs
float lowerBand1 = _vwap - stdevAbs
float upperBand2 = _vwap + stdevAbs * 2
float lowerBand2 = _vwap - stdevAbs * 2
float upperBand3 = _vwap + stdevAbs * 3
float lowerBand3 = _vwap - stdevAbs * 3

// ———————————————————— Previous Period Storage {

var float prevVwap = na
var float prevUpper1 = na, var float prevLower1 = na
var float prevUpper2 = na, var float prevLower2 = na
var float prevUpper3 = na, var float prevLower3 = na

if isNewPeriod and not na(vwapValue[1])
    prevVwap := vwapValue[1]
    prevUpper1 := upperBand1[1]
    prevLower1 := lowerBand1[1]
    prevUpper2 := upperBand2[1]
    prevLower2 := lowerBand2[1]
    prevUpper3 := upperBand3[1]
    prevLower3 := lowerBand3[1]

// ———————————————————— Plots - Current Period {

plot(vwapValue, title = "VWAP", color = color.new(color.white, 25), linewidth = 2)

// Band 1
p_upper1 = plot(showBand_1 ? upperBand1 : na, title="Upper Band 1", color = bandLineColor)
p_lower1 = plot(showBand_1 ? lowerBand1 : na, title="Lower Band 1", color = bandLineColor)
fill(p_upper1, p_lower1, title="Band 1 Fill", color = showBand_1 ? bandFillColor : na)

// Band 2
p_upper2 = plot(showBand_2 ? upperBand2 : na, title="Upper Band 2", color = bandLineColor)
p_lower2 = plot(showBand_2 ? lowerBand2 : na, title="Lower Band 2", color = bandLineColor)
fill(p_upper2, p_upper1, title="Band 2 Upper Fill", color = showBand_2 ? bandFillColor : na)
fill(p_lower1, p_lower2, title="Band 2 Lower Fill", color = showBand_2 ? bandFillColor : na)

// Band 3
p_upper3 = plot(showBand_3 ? upperBand3 : na, title="Upper Band 3", color = bandLineColor)
p_lower3 = plot(showBand_3 ? lowerBand3 : na, title="Lower Band 3", color = bandLineColor)
fill(p_upper3, p_upper2, title="Band 3 Upper Fill", color = showBand_3 ? bandFillColor : na)
fill(p_lower2, p_lower3, title="Band 3 Lower Fill", color = showBand_3 ? bandFillColor : na)

// ———————————————————— Plots - Previous Period {

plot(showPrevPeriod ? prevVwap : na, title = "Previous VWAP", color = color.new(color.white, 25), linewidth = 2)

// Previous Band 1
pp_upper1 = plot(showPrevPeriod and showPrevBand_1 ? prevUpper1 : na, title = "Prev Upper Band 1", color = prevBandLineColor)
pp_lower1 = plot(showPrevPeriod and showPrevBand_1 ? prevLower1 : na, title = "Prev Lower Band 1", color = prevBandLineColor)
fill(pp_upper1, pp_lower1, title = "Prev Band 1 Fill", color = showPrevPeriod and showPrevBand_1 ? prevBandFillColor : na)

// Previous Band 2
pp_upper2 = plot(showPrevPeriod and showPrevBand_2 ? prevUpper2 : na, title = "Prev Upper Band 2", color = prevBandLineColor)
pp_lower2 = plot(showPrevPeriod and showPrevBand_2 ? prevLower2 : na, title = "Prev Lower Band 2", color = prevBandLineColor)
fill(pp_upper2, pp_upper1, title = "Prev Band 2 Upper Fill", color = showPrevPeriod and showPrevBand_2 ? prevBandFillColor : na)
fill(pp_lower1, pp_lower2, title = "Prev Band 2 Lower Fill", color = showPrevPeriod and showPrevBand_2 ? prevBandFillColor : na)

// Previous Band 3
pp_upper3 = plot(showPrevPeriod and showPrevBand_3 ? prevUpper3 : na, title = "Prev Upper Band 3", color = prevBandLineColor)
pp_lower3 = plot(showPrevPeriod and showPrevBand_3 ? prevLower3 : na, title = "Prev Lower Band 3", color = prevBandLineColor)
fill(pp_upper3, pp_upper2, title = "Prev Band 3 Upper Fill", color = showPrevPeriod and showPrevBand_3 ? prevBandFillColor : na)
fill(pp_lower2, pp_lower3, title = "Prev Band 3 Lower Fill", color = showPrevPeriod and showPrevBand_3 ? prevBandFillColor : na)
