// This Pine Script™ source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/

//@version=6
indicator("Weekend Anomalies", overlay=true, max_lines_count=500, max_labels_count=500)

// 1. WEEKEND EXTREME: weekend high/low exceeding all 4 prior weekdays (cmeC phase)
//    - Emitted as a LIVE PREVIEW during the weekend, anchored to the wick that set wH/wL
//    - Updates as wH/wL grow during the cmeC phase
//    - Frozen during the brief weekend-with-CME-open window (Sun 5–7PM CT)
//    - Sweep detection works on the live preview
//    - Promoted to a permanent level on weekend exit if still valid and unswept
// 2. CME GAP FILL: gap between Friday 4PM CT close and Sunday 5PM CT open
//    - Fill detected at 1H to avoid HTF same-bar ambiguity
//    - Line anchors to the LAST in-session chart bar (cmeCloseBarIdx = bar_index - 1
//      at the transition). This is the bar that contains the close moment as its
//      right edge, which is the user's preferred visual anchor across all
//      chart timeframes.
//
// All lines drawn with xloc.bar_index (capped at bar_index - 9999 to satisfy
// Pine's lookback limit on LTF charts where the level is many bars old).

// ─────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────

string GRP_EXT   = "Weekend Extremes"
string GRP_GAP   = "CME Gap Fill"
string GRP_ALERT = "Alerts"

highColor  = input.color(color.new(color.red,    25), "High Color",           group=GRP_EXT,  display=display.none)
lowColor   = input.color(color.new(color.green,  25), "Low Color",            group=GRP_EXT,  display=display.none)
lineWidth  = input.int(1,  "Line Width",  minval=1, maxval=4,                 group=GRP_EXT,  display=display.none)
lineStyle  = input.string("Dotted", "Line Style", options=["Solid","Dashed","Dotted"], group=GRP_EXT, display=display.none)
showLabels = input.bool(true, "Show Labels",                                   group=GRP_EXT,  display=display.none)

showGap    = input.bool(true,  "Show CME Gap Levels",                         group=GRP_GAP,  display=display.none)
gapColor   = input.color(color.new(color.yellow, 25), "Gap Color",            group=GRP_GAP,  display=display.none)
gapWidth   = input.int(1,  "Gap Line Width", minval=1, maxval=4,              group=GRP_GAP,  display=display.none)
gapStyle   = input.string("Dotted", "Gap Line Style", options=["Solid","Dashed","Dotted"], group=GRP_GAP, display=display.none)
minGapPct  = input.float(0.5, "Min Gap %", minval=0.0, step=0.1,             group=GRP_GAP,  display=display.none)

alertOnSweep   = input.bool(true, "Alert On Sweep",    group=GRP_ALERT, display=display.none)
alertOnGapFill = input.bool(true, "Alert On Gap Fill", group=GRP_ALERT, display=display.none)

// ─────────────────────────────────────────────────────────────
// CONSTANTS
// ─────────────────────────────────────────────────────────────

int maxExtLevels = 5
int maxGapLevels = 10
int extStaleMs   = 5 * 86400000
int biLookback   = 9999

bool isBTC = str.contains(str.upper(syminfo.basecurrency), "BTC") or
             str.contains(str.upper(syminfo.ticker), "BTC")

// ─────────────────────────────────────────────────────────────
// HELPERS
// ─────────────────────────────────────────────────────────────

getLineStyle(string s) =>
    switch s
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

f_safeBI(int storedBI) =>
    math.max(storedBI, bar_index - biLookback)

// ─────────────────────────────────────────────────────────────
// CHART-SIDE CME CLOSE BAR_INDEX TRACKING
//
// The 1H security function detects the gap on Sunday CME open, by which
// point the chart's bar_index points to Sunday — but the gap level
// itself was set at Friday's close, many chart bars earlier.
//
// We track the chart bar_index of the LAST IN-SESSION bar before the
// close (bar_index - 1 at the transition). This bar's right edge falls
// at the close moment on every chart timeframe whose bars align to the
// close, making it the consistent visual anchor.
//
// Daily maintenance breaks Mon–Thu also trigger this transition, but
// they get overwritten by Friday's transition before any gap emission
// references the value (gap emissions only happen on Sunday opens).
// ─────────────────────────────────────────────────────────────

int  chartDow  = dayofweek(time, "America/Chicago")
int  chartHr   = hour(time,      "America/Chicago")
bool chartInS  = not ((chartDow == 6 and chartHr >= 16) or chartDow == 7 or (chartDow == 1 and chartHr < 17))

var bool chartPrevS     = true
var int  cmeCloseBarIdx = na

if not chartInS and chartPrevS and bar_index > 0
    cmeCloseBarIdx := bar_index - 1

chartPrevS := chartInS

// ─────────────────────────────────────────────────────────────
// 1H FUNCTION: CME GAP DETECTION + FILL TRACKING
// ─────────────────────────────────────────────────────────────

f_cmeGap(float minPct) =>
    int  dow  = dayofweek(time, "America/Chicago")
    int  hr   = hour(time,      "America/Chicago")
    bool inS  = not ((dow == 6 and hr >= 16) or dow == 7 or (dow == 1 and hr < 17))

    var bool  prevS    = true
    var float closeRef = na
    var int   closeT   = na
    var float gapLvl   = na
    var int   gapTyp   = 0
    var int   gapAnc   = na
    var bool  gapFlld  = false

    if not inS and prevS
        closeRef := close[1]
        closeT   := time[1]
        gapLvl   := na
        gapTyp   := 0
        gapAnc   := na
        gapFlld  := false

    if inS and not prevS and not na(closeRef)
        if dayofweek(closeT, "America/Chicago") == 6
            float m = math.abs(open - closeRef) / closeRef * 100
            if m >= minPct
                gapLvl := closeRef
                gapTyp := open > closeRef ? 1 : -1
                gapAnc := closeT
                gapFlld := (gapTyp == 1 and low <= gapLvl) or (gapTyp == -1 and high >= gapLvl)

    if not na(gapAnc) and not gapFlld
        if (gapTyp == 1 and low <= gapLvl) or (gapTyp == -1 and high >= gapLvl)
            gapFlld := true

    prevS := inS
    [gapLvl, gapTyp, gapAnc, gapFlld]

// ─────────────────────────────────────────────────────────────
// 1H FUNCTION: WEEKEND EXTREMES with LIVE EMISSION
// ─────────────────────────────────────────────────────────────

f_weekendExtremes() =>
    int  dow  = dayofweek(time, "America/Chicago")
    int  hr   = hour(time,      "America/Chicago")
    bool cmeC = (dow == 6 and hr >= 16) or dow == 7 or (dow == 1 and hr < 17)
    bool isWk = dayofweek(time, "UTC") == 7 or dayofweek(time, "UTC") == 1
    bool nd   = ta.change(time("D")) != 0

    var float d1H = na
    var float d1L = na
    var float d2H = na
    var float d2L = na
    var float d3H = na
    var float d3L = na
    var float d4H = na
    var float d4L = na
    var float cH  = na
    var float cL  = na
    var bool  inW = false
    var float wH  = na
    var int   wHT = na
    var float wL  = na
    var int   wLT = na
    var float rHP = na
    var int   rHT = na
    var float rLP = na
    var int   rLT = na

    if nd and not isWk and not inW
        d4H := d3H
        d4L := d3L
        d3H := d2H
        d3L := d2L
        d2H := d1H
        d2L := d1L
        if not na(cH)
            d1H := cH
            d1L := cL
        cH := high
        cL := low
    else if not isWk and not inW
        cH := na(cH) ? high : math.max(cH, high)
        cL := na(cL) ? low  : math.min(cL, low)

    if isWk and not inW
        inW := true
        d4H := d3H
        d4L := d3L
        d3H := d2H
        d3L := d2L
        d2H := d1H
        d2L := d1L
        if not na(cH)
            d1H := cH
            d1L := cL
        cH := na
        cL := na
        if cmeC
            wH := high
            wHT := time
            wL := low
            wLT := time

    if isWk and inW and cmeC
        if na(wH)
            wH := high
            wHT := time
            wL := low
            wLT := time
        else
            if high > wH
                wH := high
                wHT := time
            if low < wL
                wL := low
                wLT := time

        bool h4 = not (na(d1H) or na(d2H) or na(d3H) or na(d4H))
        if h4 and not na(wH) and wH > d1H and wH > d2H and wH > d3H and wH > d4H
            rHP := wH
            rHT := wHT
        else
            rHP := na
            rHT := na
        if h4 and not na(wL) and wL < d1L and wL < d2L and wL < d3L and wL < d4L
            rLP := wL
            rLT := wLT
        else
            rLP := na
            rLT := na

    if not isWk and inW
        inW := false
        wH  := na
        wL  := na
        wHT := na
        wLT := na

    [rHP, rHT, rLP, rLT, isWk]

// ─────────────────────────────────────────────────────────────
// REQUEST AT 1H
// ─────────────────────────────────────────────────────────────

[h1GapLvl, h1GapTyp, h1GapAnc, h1GapFlld] = request.security(
    syminfo.tickerid, "60", f_cmeGap(minGapPct), gaps=barmerge.gaps_off)

[h1HighP, h1HighT, h1LowP, h1LowT, h1IsWk] = request.security(
    syminfo.tickerid, "60", f_weekendExtremes(), gaps=barmerge.gaps_off)

// ─────────────────────────────────────────────────────────────
// LEVEL STORAGE — Permanent (Weekend Extremes after promotion)
// ─────────────────────────────────────────────────────────────

var float[] lvlPrice  = array.new_float(0)
var int[]   lvlType   = array.new_int(0)
var int[]   lvlBar    = array.new_int(0)
var int[]   lvlBarIdx = array.new_int(0)
var line[]  lvlLines  = array.new_line(0)
var label[] lvlLabels = array.new_label(0)

// ─────────────────────────────────────────────────────────────
// LEVEL STORAGE — CME Gap Fill
// ─────────────────────────────────────────────────────────────

var float[] gapPrice  = array.new_float(0)
var int[]   gapType   = array.new_int(0)
var int[]   gapBar    = array.new_int(0)
var int[]   gapBarIdx = array.new_int(0)
var line[]  gapLines  = array.new_line(0)
var label[] gapLabels = array.new_label(0)

// ─────────────────────────────────────────────────────────────
// PREVIEW STATE — Live weekend extremes (during weekend only)
// ─────────────────────────────────────────────────────────────

var float previewHighP      = na
var int   previewHighT      = na
var int   previewHighBarIdx = na
var bool  previewHighSwept  = false
var line  previewHighLine   = na
var label previewHighLabel  = na

var float previewLowP       = na
var int   previewLowT       = na
var int   previewLowBarIdx  = na
var bool  previewLowSwept   = false
var line  previewLowLine    = na
var label previewLowLabel   = na

// ─────────────────────────────────────────────────────────────
// WEEKEND TRANSITION DETECTION
// ─────────────────────────────────────────────────────────────

var bool prevWkActive = false
bool weekendStarted = h1IsWk and not prevWkActive
bool weekendEnded   = not h1IsWk and prevWkActive
prevWkActive := h1IsWk

if weekendStarted
    previewHighSwept := false
    previewLowSwept  := false

// ─────────────────────────────────────────────────────────────
// CME GAP EMISSION (anchored to last in-session bar)
// ─────────────────────────────────────────────────────────────

var int lastGapAnc = -1
bool newGapEmit = showGap and isBTC and not na(h1GapAnc) and h1GapAnc != lastGapAnc

if newGapEmit
    lastGapAnc := h1GapAnc
    array.push(gapPrice,  h1GapLvl)
    array.push(gapType,   h1GapTyp)
    array.push(gapBar,    h1GapAnc)
    array.push(gapBarIdx, na(cmeCloseBarIdx) ? bar_index : cmeCloseBarIdx)
    array.push(gapLines,  line(na))
    array.push(gapLabels, label(na))

// ─────────────────────────────────────────────────────────────
// PREVIEW UPDATE (during weekend)
// ─────────────────────────────────────────────────────────────

var bool sweepHighFired = false
var bool sweepLowFired  = false
sweepHighFired := false
sweepLowFired  := false

if isBTC and h1IsWk
    if not previewHighSwept
        if not na(h1HighP) and not na(h1HighT)
            if na(previewHighBarIdx) or h1HighT != previewHighT
                previewHighBarIdx := bar_index
            previewHighP := h1HighP
            previewHighT := h1HighT
        else
            previewHighP      := na
            previewHighT      := na
            previewHighBarIdx := na

    if not previewHighSwept and not na(previewHighP) and high > previewHighP
        previewHighSwept  := true
        sweepHighFired    := true
        previewHighP      := na
        previewHighT      := na
        previewHighBarIdx := na

    if not previewLowSwept
        if not na(h1LowP) and not na(h1LowT)
            if na(previewLowBarIdx) or h1LowT != previewLowT
                previewLowBarIdx := bar_index
            previewLowP := h1LowP
            previewLowT := h1LowT
        else
            previewLowP      := na
            previewLowT      := na
            previewLowBarIdx := na

    if not previewLowSwept and not na(previewLowP) and low < previewLowP
        previewLowSwept  := true
        sweepLowFired    := true
        previewLowP      := na
        previewLowT      := na
        previewLowBarIdx := na

// ─────────────────────────────────────────────────────────────
// PROMOTION ON WEEKEND EXIT
// ─────────────────────────────────────────────────────────────

if weekendEnded and isBTC
    if not previewHighSwept and not na(previewHighP) and not na(previewHighT) and not na(previewHighBarIdx)
        array.push(lvlPrice,  previewHighP)
        array.push(lvlType,   1)
        array.push(lvlBar,    previewHighT)
        array.push(lvlBarIdx, previewHighBarIdx)
        array.push(lvlLines,  line(na))
        array.push(lvlLabels, label(na))

    if not previewLowSwept and not na(previewLowP) and not na(previewLowT) and not na(previewLowBarIdx)
        array.push(lvlPrice,  previewLowP)
        array.push(lvlType,   -1)
        array.push(lvlBar,    previewLowT)
        array.push(lvlBarIdx, previewLowBarIdx)
        array.push(lvlLines,  line(na))
        array.push(lvlLabels, label(na))

    line.delete(previewHighLine)
    label.delete(previewHighLabel)
    line.delete(previewLowLine)
    label.delete(previewLowLabel)
    previewHighLine   := na
    previewHighLabel  := na
    previewLowLine    := na
    previewLowLabel   := na
    previewHighP      := na
    previewHighT      := na
    previewHighBarIdx := na
    previewLowP       := na
    previewLowT       := na
    previewLowBarIdx  := na

// ─────────────────────────────────────────────────────────────
// SWEEP / STALE — Permanent Weekend Extremes
// ─────────────────────────────────────────────────────────────

if array.size(lvlPrice) > 0
    for j = array.size(lvlPrice) - 1 to 0
        float p       = array.get(lvlPrice, j)
        int   t       = array.get(lvlType,  j)
        int   lvlTime = array.get(lvlBar,   j)
        bool  swept   = (t ==  1 and high > p) or (t == -1 and low < p)
        bool  stale   = (time - lvlTime) > extStaleMs

        if swept
            if t == 1
                sweepHighFired := true
            else
                sweepLowFired := true

        if swept or stale
            line.delete( array.get(lvlLines,  j))
            label.delete(array.get(lvlLabels, j))
            array.remove(lvlPrice,  j)
            array.remove(lvlType,   j)
            array.remove(lvlBar,    j)
            array.remove(lvlBarIdx, j)
            array.remove(lvlLines,  j)
            array.remove(lvlLabels, j)

while array.size(lvlPrice) > maxExtLevels
    line.delete( array.get(lvlLines,  0))
    label.delete(array.get(lvlLabels, 0))
    array.shift(lvlPrice)
    array.shift(lvlType)
    array.shift(lvlBar)
    array.shift(lvlBarIdx)
    array.shift(lvlLines)
    array.shift(lvlLabels)

// ─────────────────────────────────────────────────────────────
// FILL — CME Gap Fill
// ─────────────────────────────────────────────────────────────

var bool gapFillFired = false
gapFillFired := false

if array.size(gapPrice) > 0
    for j = array.size(gapPrice) - 1 to 0
        float p   = array.get(gapPrice, j)
        int   t   = array.get(gapType,  j)
        int   anc = array.get(gapBar,   j)

        bool isCurrent = not na(h1GapAnc) and anc == h1GapAnc
        bool filled = isCurrent
             ? h1GapFlld
             : ((t == 1 and low <= p) or (t == -1 and high >= p))

        if filled
            gapFillFired := true
            line.delete( array.get(gapLines,  j))
            label.delete(array.get(gapLabels, j))
            array.remove(gapPrice,  j)
            array.remove(gapType,   j)
            array.remove(gapBar,    j)
            array.remove(gapBarIdx, j)
            array.remove(gapLines,  j)
            array.remove(gapLabels, j)

while array.size(gapPrice) > maxGapLevels
    line.delete( array.get(gapLines,  0))
    label.delete(array.get(gapLabels, 0))
    array.shift(gapPrice)
    array.shift(gapType)
    array.shift(gapBar)
    array.shift(gapBarIdx)
    array.shift(gapLines)
    array.shift(gapLabels)

// ─────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────

if alertOnSweep and sweepHighFired
    alert("Weekend High swept | " + syminfo.ticker + " | " + str.tostring(close, "#.##"), alert.freq_once_per_bar)

if alertOnSweep and sweepLowFired
    alert("Weekend Low swept | " + syminfo.ticker + " | " + str.tostring(close, "#.##"), alert.freq_once_per_bar)

if alertOnGapFill and gapFillFired
    alert("CME Gap filled | " + syminfo.ticker + " | " + str.tostring(close, "#.##"), alert.freq_once_per_bar)

alertcondition(sweepHighFired, "Weekend High Swept", "Weekend High swept")
alertcondition(sweepLowFired,  "Weekend Low Swept",  "Weekend Low swept")
alertcondition(gapFillFired,   "CME Gap Filled",     "CME Gap filled")

// ─────────────────────────────────────────────────────────────
// DRAW — Preview (live during weekend)
// ─────────────────────────────────────────────────────────────

line.delete(previewHighLine)
label.delete(previewHighLabel)
line.delete(previewLowLine)
label.delete(previewLowLabel)
previewHighLine  := na
previewHighLabel := na
previewLowLine   := na
previewLowLabel  := na

if h1IsWk and isBTC
    if not na(previewHighP) and not na(previewHighBarIdx)
        previewHighLine := line.new(
             f_safeBI(previewHighBarIdx), previewHighP, bar_index, previewHighP,
             color=highColor, width=lineWidth,
             style=getLineStyle(lineStyle),
             extend=extend.right, xloc=xloc.bar_index)
        if showLabels
            previewHighLabel := label.new(
                 bar_index, previewHighP, "Weekend High",
                 color=color.new(color.black, 100), textcolor=highColor,
                 style=label.style_label_lower_left,
                 size=size.small, xloc=xloc.bar_index)

    if not na(previewLowP) and not na(previewLowBarIdx)
        previewLowLine := line.new(
             f_safeBI(previewLowBarIdx), previewLowP, bar_index, previewLowP,
             color=lowColor, width=lineWidth,
             style=getLineStyle(lineStyle),
             extend=extend.right, xloc=xloc.bar_index)
        if showLabels
            previewLowLabel := label.new(
                 bar_index, previewLowP, "Weekend Low",
                 color=color.new(color.black, 100), textcolor=lowColor,
                 style=label.style_label_upper_left,
                 size=size.small, xloc=xloc.bar_index)

// ─────────────────────────────────────────────────────────────
// DRAW — Permanent Weekend Extremes
// ─────────────────────────────────────────────────────────────

if array.size(lvlPrice) > 0
    for j = 0 to array.size(lvlPrice) - 1
        float p      = array.get(lvlPrice,  j)
        int   t      = array.get(lvlType,   j)
        int   startI = array.get(lvlBarIdx, j)
        color col    = t == 1 ? highColor : lowColor

        line.delete( array.get(lvlLines,  j))
        label.delete(array.get(lvlLabels, j))

        array.set(lvlLines, j, line.new(
             f_safeBI(startI), p, bar_index, p,
             color=col, width=lineWidth,
             style=getLineStyle(lineStyle),
             extend=extend.right, xloc=xloc.bar_index))

        if showLabels
            string lbl = t == 1 ? "Weekend High" : "Weekend Low"
            array.set(lvlLabels, j, label.new(
                 bar_index, p, lbl,
                 color=color.new(color.black, 100), textcolor=col,
                 style=t == 1 ? label.style_label_lower_left : label.style_label_upper_left,
                 size=size.small, xloc=xloc.bar_index))

// ─────────────────────────────────────────────────────────────
// DRAW — CME Gap Fill
// ─────────────────────────────────────────────────────────────

if showGap and array.size(gapPrice) > 0
    for j = 0 to array.size(gapPrice) - 1
        float p      = array.get(gapPrice,  j)
        int   t      = array.get(gapType,   j)
        int   startI = array.get(gapBarIdx, j)

        line.delete( array.get(gapLines,  j))
        label.delete(array.get(gapLabels, j))

        array.set(gapLines, j, line.new(
             f_safeBI(startI), p, bar_index, p,
             color=gapColor, width=gapWidth,
             style=getLineStyle(gapStyle),
             extend=extend.right, xloc=xloc.bar_index))

        if showLabels
            array.set(gapLabels, j, label.new(
                 bar_index, p, "CME Gap Fill",
                 color=color.new(color.black, 100), textcolor=gapColor,
                 style=t == 1 ? label.style_label_upper_left : label.style_label_lower_left,
                 size=size.small, xloc=xloc.bar_index))

plot(na)
