//@version=5
indicator("Gann Squares", overlay=true, max_lines_count=100, max_labels_count=100)

// ─────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────

string GRP_CORE  = "Core Settings"
string GRP_CARD  = "Cardinal Levels (0°/90°/180°/270°)"
string GRP_CROSS = "Cross Levels (45°/135°/225°/315°)"
string GRP_LABEL = "Labels"

// Core
priceLevel = input.int(5, "Price Levels", options=[3, 5], group=GRP_CORE, display=display.none,
     tooltip="3 = core S/R + midpoint. 5 = adds one extra level per side.")
lineSpan   = input.int(1, "Line Span (bars)", minval=1, maxval=50, group=GRP_CORE, display=display.none,
     tooltip="Width of level markers in bars. 1 = minimal nub.")

// Cardinal levels
showCardinal       = input.bool(true, "Show Cardinal Levels", group=GRP_CARD, display=display.none)
cardinalColor      = input.color(color.new(color.white, 0), "Color", group=GRP_CARD, display=display.none)
cardinalWidth      = input.int(1, "Width", minval=1, maxval=4, group=GRP_CARD, display=display.none)
cardinalStyle      = input.string("Dotted", "Style", options=["Solid", "Dashed", "Dotted"], group=GRP_CARD, display=display.none)
cardinalExtraColor = input.color(color.new(color.white, 0), "Extended Level Color", group=GRP_CARD, display=display.none,
     tooltip="Color for R2/S2 levels (5-level mode only).")
cardinalExtraWidth = input.int(1, "Extended Level Width", minval=1, maxval=4, group=GRP_CARD, display=display.none)
cardinalExtraStyle = input.string("Dotted", "Extended Level Style", options=["Solid", "Dashed", "Dotted"], group=GRP_CARD, display=display.none)

// Cross levels
showCross       = input.bool(true, "Show Cross Levels", group=GRP_CROSS, display=display.none)
crossColor      = input.color(color.new(color.white, 50), "Color", group=GRP_CROSS, display=display.none)
crossWidth      = input.int(1, "Width", minval=1, maxval=4, group=GRP_CROSS, display=display.none)
crossStyle      = input.string("Dotted", "Style", options=["Solid", "Dashed", "Dotted"], group=GRP_CROSS, display=display.none)
crossExtraColor = input.color(color.new(color.white, 50), "Extended Level Color", group=GRP_CROSS, display=display.none,
     tooltip="Color for second cross level (5-level mode only).")
crossExtraWidth = input.int(1, "Extended Level Width", minval=1, maxval=4, group=GRP_CROSS, display=display.none)
crossExtraStyle = input.string("Dotted", "Extended Level Style", options=["Solid", "Dashed", "Dotted"], group=GRP_CROSS, display=display.none)

// Labels
showLabels = input.bool(false, "Show Labels", group=GRP_LABEL, display=display.none)
labelColor = input.color(color.new(color.white, 0), "Label Color", group=GRP_LABEL, display=display.none)

// ─────────────────────────────────────────────────────────────
// HELPERS
// ─────────────────────────────────────────────────────────────

getLineStyle(string s) =>
    switch s
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

// ─────────────────────────────────────────────────────────────
// GANN SPIRAL GENERATION
// ─────────────────────────────────────────────────────────────

var float[] gannNum = array.new_float(0)

if barstate.isfirst
    array.clear(gannNum)
    int maxRing = 20
    for ring = 0 to maxRing
        for cardinal = 0 to 3
            float gNum = 0.0
            if ring == 0 and cardinal == 0
                gNum := ring + (ring + 2)
            else if ring > 0 and cardinal == 0
                gNum := nz(array.get(gannNum, array.size(gannNum) - 1)) + (ring + 1) + ring
            else
                gNum := nz(array.get(gannNum, array.size(gannNum) - 1)) + (ring + 2) + ring
            array.push(gannNum, gNum)

// ─────────────────────────────────────────────────────────────
// DENOMINATOR (SCALING FACTOR)
// ─────────────────────────────────────────────────────────────

getDenominator(float p) =>
    float d = 1.0
    if p >= 10000
        d := 0.01
    else if p >= 1000
        d := 0.1
    else if p >= 100
        d := 1.0
    else if p >= 10
        d := 10.0
    else if p >= 0.05
        d := 100.0
    else
        d := 1000.0
    d

// ─────────────────────────────────────────────────────────────
// DRAWING STATE
// ─────────────────────────────────────────────────────────────

var line[]  drawnLines  = array.new_line(0)
var label[] drawnLabels = array.new_label(0)

// ─────────────────────────────────────────────────────────────
// MAIN LOGIC
// ─────────────────────────────────────────────────────────────

if barstate.islast and array.size(gannNum) > 0
    // Cleanup
    if array.size(drawnLines) > 0
        for i = 0 to array.size(drawnLines) - 1
            line.delete(array.get(drawnLines, i))
        array.clear(drawnLines)
    if array.size(drawnLabels) > 0
        for i = 0 to array.size(drawnLabels) - 1
            label.delete(array.get(drawnLabels, i))
        array.clear(drawnLabels)

    // Anchor: always dynamic from current close
    float anchor = close
    float denom  = getDenominator(anchor)
    float scaled = anchor * denom

    // Find bracket in spiral
    int gannPos       = -1
    float resistance  = na
    float support     = na
    float crossMid    = na
    int maxIdx        = array.size(gannNum) - 1

    for i = 0 to maxIdx
        int next = i == maxIdx ? i : i + 1
        if array.get(gannNum, i) <= scaled and array.get(gannNum, next) > scaled
            resistance := array.get(gannNum, next) / denom
            support    := array.get(gannNum, i) / denom
            crossMid   := (support + resistance) / 2.0
            gannPos    := i
            break

    if not na(resistance) and gannPos >= 0
        // Line span: centered on current bar
        int halfSpan = math.floor(lineSpan / 2)
        int startX   = bar_index - halfSpan
        int endX     = bar_index + math.max(halfSpan, 1)
        int labelX   = endX + 3
        int gannWeight = anchor >= crossMid ? 2 : -1

        // --- Cardinal levels ---
        if showCardinal
            array.push(drawnLines, line.new(startX, resistance, endX, resistance,
                 color=cardinalColor, width=cardinalWidth,
                 style=getLineStyle(cardinalStyle)))
            array.push(drawnLines, line.new(startX, support, endX, support,
                 color=cardinalColor, width=cardinalWidth,
                 style=getLineStyle(cardinalStyle)))

            if showLabels
                array.push(drawnLabels, label.new(labelX, resistance,
                     "R1  " + str.tostring(resistance, format.mintick),
                     style=label.style_label_lower_left,
                     color=color.new(color.black, 100), textcolor=labelColor, size=size.small))
                array.push(drawnLabels, label.new(labelX, support,
                     "S1  " + str.tostring(support, format.mintick),
                     style=label.style_label_upper_left,
                     color=color.new(color.black, 100), textcolor=labelColor, size=size.small))

            // R2/S2 (5-level mode)
            if priceLevel == 5 and gannPos + gannWeight >= 0 and gannPos + gannWeight < array.size(gannNum)
                float extraLevel = array.get(gannNum, gannPos + gannWeight) / denom
                array.push(drawnLines, line.new(startX, extraLevel, endX, extraLevel,
                     color=cardinalExtraColor, width=cardinalExtraWidth,
                     style=getLineStyle(cardinalExtraStyle)))
                if showLabels
                    string extraTag = gannWeight > 0 ? "R2  " : "S2  "
                    array.push(drawnLabels, label.new(labelX, extraLevel,
                         extraTag + str.tostring(extraLevel, format.mintick),
                         style=gannWeight > 0 ? label.style_label_lower_left : label.style_label_upper_left,
                         color=color.new(color.black, 100), textcolor=labelColor, size=size.small))

        // --- Cross levels ---
        if showCross
            array.push(drawnLines, line.new(startX, crossMid, endX, crossMid,
                 color=crossColor, width=crossWidth,
                 style=getLineStyle(crossStyle)))

            if showLabels
                string midTag = anchor >= crossMid ? "S½  " : "R½  "
                array.push(drawnLabels, label.new(labelX, crossMid,
                     midTag + str.tostring(crossMid, format.mintick),
                     style=anchor >= crossMid ? label.style_label_upper_left : label.style_label_lower_left,
                     color=color.new(color.black, 100), textcolor=labelColor, size=size.small))

            // Second cross level (5-level mode)
            if priceLevel == 5
                int upperIdx = math.min(gannPos + 2, array.size(gannNum) - 1)
                int lowerIdx = math.max(gannPos - 1, 0)
                float crossMid2 = na
                if gannWeight > 0
                    crossMid2 := (array.get(gannNum, gannPos + 1) + array.get(gannNum, upperIdx)) / 2.0 / denom
                else
                    crossMid2 := (array.get(gannNum, lowerIdx) + array.get(gannNum, gannPos)) / 2.0 / denom

                if not na(crossMid2)
                    array.push(drawnLines, line.new(startX, crossMid2, endX, crossMid2,
                         color=crossExtraColor, width=crossExtraWidth,
                         style=getLineStyle(crossExtraStyle)))
                    if showLabels
                        string cross2Tag = gannWeight > 0 ? "R½₂  " : "S½₂  "
                        array.push(drawnLabels, label.new(labelX, crossMid2,
                             cross2Tag + str.tostring(crossMid2, format.mintick),
                             style=gannWeight > 0 ? label.style_label_lower_left : label.style_label_upper_left,
                             color=color.new(color.black, 100), textcolor=labelColor, size=size.small))
