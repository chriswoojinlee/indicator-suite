// ============================================================================
Q_GROUP = "Quarterly"
show_dq_VWAP = input.bool(false, "developing-VWAP", group=Q_GROUP, inline="dq_vwap", display=display.none)
color_dq_VWAP = input.color(color.new(color.white, 25), "", group=Q_GROUP, inline="dq_vwap", display=display.none)
width_dq_VWAP = input.int(3, "", minval=1, maxval=4, group=Q_GROUP, inline="dq_vwap", display=display.none)
style_dq_VWAP = input.string("Dotted", "", options=["Solid", "Dashed", "Dotted"], group=Q_GROUP, inline="dq_vwap", display=display.none)

show_dq_VAH = input.bool(false, "developing-VAH", group=Q_GROUP, inline="dq_vah", display=display.none)
color_dq_VAH = input.color(color.new(color.white, 85), "", group=Q_GROUP, inline="dq_vah", display=display.none)
