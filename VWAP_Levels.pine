show_pm_VWAP = input.bool(false, "previous-VWAP", group=M_GROUP, inline="pm_vwap", display=display.none)
color_pm_VWAP = input.color(color.new(color.white, 25), "", group=M_GROUP, inline="pm_vwap", display=display.none)
width_pm_VWAP = input.int(2, "", minval=1, maxval=4, group=M_GROUP, inline="pm_vwap", display=display.none)
style_pm_VWAP = input.string("Dotted", "", options=["Solid", "Dashed", "Dotted"], group=M_GROUP, inline="pm_vwap", display=display.none)

show_pm_VAH = input.bool(false, "previous-VAH", group=M_GROUP, inline="pm_vah", display=display.none)
color_pm_VAH = input.color(color.new(color.white, 85), "", group=M_GROUP, inline="pm_vah", display=display.none)
width_pm_VAH = input.int(2, "", minval=1, maxval=4, group=M_GROUP, inline="pm_vah", display=display.none)
style_pm_VAH = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], group=M_GROUP, inline="pm_vah", display=display.none)

show_pm_VAL = input.bool(false, "previous-VAL", group=M_GROUP, inline="pm_val", display=display.none)
color_pm_VAL = input.color(color.new(color.white, 85), "", group=M_GROUP, inline="pm_val", display=display.none)
width_pm_VAL = input.int(2, "", minval=1, maxval=4, group=M_GROUP, inline="pm_val", display=display.none)
style_pm_VAL = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], group=M_GROUP, inline="pm_val", display=display.none)

// ============================================================================
