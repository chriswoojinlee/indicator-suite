M_GROUP = "Monthly"
show_dm_VWAP = input.bool(false, "developing-VWAP", group=M_GROUP, inline="dm_vwap", display=display.none)
color_dm_VWAP = input.color(color.new(color.white, 25), "", group=M_GROUP, inline="dm_vwap", display=display.none)
width_dm_VWAP = input.int(2, "", minval=1, maxval=4, group=M_GROUP, inline="dm_vwap", display=display.none)
style_dm_VWAP = input.string("Dotted", "", options=["Solid", "Dashed", "Dotted"], group=M_GROUP, inline="dm_vwap", display=display.none)

show_dm_VAH = input.bool(false, "developing-VAH", group=M_GROUP, inline="dm_vah", display=display.none)
color_dm_VAH = input.color(color.new(color.white, 85), "", group=M_GROUP, inline="dm_vah", display=display.none)
