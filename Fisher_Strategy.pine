//@version=6
strategy(title="Fisher Transform Strategy", shorttitle="Fisher Strategy", overlay=false, 
         initial_capital=10000, default_qty_type=strategy.percent_of_equity, 
         default_qty_value=33, commission_type=strategy.commission.percent, 
         commission_value=0.1, slippage=5, pyramiding=10)

//This strategy backtests the Fisher Transform Buy/Sell signals with next-candle entry confirmation
//Entries occur at the open of the candle following a confirmed signal

//-----------------------------------------------------------------------------------------------------------------------------------------------------------------
//Functions
//-----------------------------------------------------------------------------------------------------------------------------------------------------------------

//Fisher Transform
fish(x, t) =>
    highval = ta.highest(x, t)
    lowval  = ta.lowest(x, t)
    val1    = 0.0
    val1   := 0.66 * ((x - lowval) / math.max(highval - lowval, 0.001) - 0.5) + 0.67*nz(val1[1], 0)
    val2    = val1 > 0.99 ? 0.999 : val1 < -0.99 ? -0.999 : val1
    fish    = 0.0
    fish   := 0.5 * math.log((1 + val2) / math.max(1 - val2, 0.001)) + 0.5*nz(fish[1], 0)
    fish

//-----------------------------------------------------------------------------------------------------------------------------------------------------------------
//Inputs
//-----------------------------------------------------------------------------------------------------------------------------------------------------------------

//Timeframe-based parameter selection (automatic, no user input)
is_minute_tf = timeframe.isintraday and timeframe.multiplier < 60
is_hourly_below_6h = timeframe.isintraday and timeframe.multiplier >= 60 and timeframe.multiplier < 360
is_6h_and_above = timeframe.multiplier >= 360 or timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly

//Source - Always HLC3 for all timeframes (automatic)
src = hlc3

//Sampling Period - varies by timeframe (automatic)
per = is_minute_tf ? 8 : is_hourly_below_6h ? 13 : 21

//Threshold Inputs - varies by timeframe (automatic)
custom_ht = is_minute_tf ? 2.0 : is_hourly_below_6h ? 1.5 : 1.0
custom_lt = is_minute_tf ? -2.0 : is_hourly_below_6h ? -1.5 : -1.0

//Strategy Inputs (ONLY user-configurable inputs)
use_stop_loss = input.bool(defval=true, title="Use Stop Loss")
stop_loss_percent = input.float(defval=33.0, title="Stop Loss %", minval=0.1, step=0.1)
allow_pyramiding = input.bool(defval=true, title="Allow Pyramiding (Double Down)")
max_pyramid_orders = input.int(defval=3, title="Max Pyramid Orders", minval=1, maxval=10)
base_position_size = input.float(defval=33.0, title="Base Position Size (%)", minval=1.0, maxval=100.0)
pyramid_multiplier = input.float(defval=1.5, title="Pyramid Size Multiplier", minval=1.0, step=0.1)

//-----------------------------------------------------------------------------------------------------------------------------------------------------------------
//Definitions
//-----------------------------------------------------------------------------------------------------------------------------------------------------------------

//Fisher Transform
fisher = nz(fish(src, per), 0)

//Oscillator
osc = fisher

//Thresholds
hth = custom_ht
lth = custom_lt

//-----------------------------------------------------------------------------------------------------------------------------------------------------------------
//Signal Detection
//-----------------------------------------------------------------------------------------------------------------------------------------------------------------

//Buy Signal: When oscillator is in oversold zone and starts reversing upward
buy_signal = (osc <= lth) and (osc > osc[1]) and (osc[1] <= osc[2])

//Sell Signal: When oscillator is in overbought zone and starts reversing downward
sell_signal = (osc >= hth) and (osc < osc[1]) and (osc[1] >= osc[2])

//Confirmed signals from previous bar (for next-candle entry)
confirmed_buy = buy_signal[1]
confirmed_sell = sell_signal[1]

//-----------------------------------------------------------------------------------------------------------------------------------------------------------------
//Strategy Logic
//-----------------------------------------------------------------------------------------------------------------------------------------------------------------

// Track how many times we've entered in the current direction
var int current_long_entries = 0
var int current_short_entries = 0
var bool was_in_long = false
var bool was_in_short = false

// Detect position changes to reset counters
bool currently_in_long = strategy.position_size > 0
bool currently_in_short = strategy.position_size < 0
bool currently_flat = strategy.position_size == 0

// Reset counters when exiting positions
if was_in_long and not currently_in_long
    current_long_entries := 0
if was_in_short and not currently_in_short
    current_short_entries := 0

was_in_long := currently_in_long
was_in_short := currently_in_short

// IMMEDIATE EXIT: Close ALL positions as soon as opposite signal prints (no confirmation wait)
if sell_signal and currently_in_long
    strategy.close_all()

if buy_signal and currently_in_short
    strategy.close_all()

//Enter long on confirmed buy signal OR pyramid on additional buy signals
if confirmed_buy and not currently_in_short
    // Calculate position size with multiplier for pyramiding
    position_multiplier = math.pow(pyramid_multiplier, current_long_entries)
    position_pct = base_position_size * position_multiplier
    
    if current_long_entries < max_pyramid_orders
        // Enter new long or add to existing long
        entry_id = "Long_" + str.tostring(current_long_entries + 1)
        strategy.entry(entry_id, strategy.long, qty=strategy.equity * position_pct / 100 / close)
        if use_stop_loss
            stop_price = current_long_entries == 0 ? close * (1 - stop_loss_percent/100) : strategy.position_avg_price * (1 - stop_loss_percent/100)
            strategy.exit("Exit_" + entry_id, entry_id, stop=stop_price)
        current_long_entries := current_long_entries + 1

//Enter short on confirmed sell signal OR pyramid on additional sell signals
if confirmed_sell and not currently_in_long
    // Calculate position size with multiplier for pyramiding
    position_multiplier = math.pow(pyramid_multiplier, current_short_entries)
    position_pct = base_position_size * position_multiplier
    
    if current_short_entries < max_pyramid_orders
        // Enter new short or add to existing short
        entry_id = "Short_" + str.tostring(current_short_entries + 1)
        strategy.entry(entry_id, strategy.short, qty=strategy.equity * position_pct / 100 / close)
        if use_stop_loss
            stop_price = current_short_entries == 0 ? close * (1 + stop_loss_percent/100) : strategy.position_avg_price * (1 + stop_loss_percent/100)
            strategy.exit("Exit_" + entry_id, entry_id, stop=stop_price)
        current_short_entries := current_short_entries + 1