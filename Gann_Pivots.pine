// https://mozilla.org/MPL/2.0/

//@version=6
indicator("Gann Pivots", overlay=true, max_lines_count=500, max_labels_count=500)

// ─────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────

string GRP_ANCHOR = "Anchor"
string GRP_STYLE  = "Visual Style"
string GRP_LABELS = "Labels"

// --- Anchor ---
manualHigh = input.float(0.0, "Range High", minval=0.0, group=GRP_ANCHOR, display=display.none,
     tooltip="High of your structural range.")
manualLow  = input.float(0.0, "Range Low", minval=0.0, group=GRP_ANCHOR, display=display.none,
     tooltip="Low of your structural range.")

levelMode = input.string("9", "Levels", options=["5", "9"], group=GRP_ANCHOR, display=display.none,
     tooltip="5: RM, RL, RH, and two extremes.\n9: adds quarter and extension levels between those.")

// --- Style ---
extendLevels  = input.bool(true, "Extend Lines", group=GRP_STYLE, display=display.none)
baseColor     = input.color(color.new(color.white, 25), "Level Color", group=GRP_STYLE, display=display.none)
boundaryColor = input.color(color.new(color.white, 0), "Boundary / Extreme Color", group=GRP_STYLE, display=display.none)
midpointColor = input.color(color.new(color.white, 0), "Midpoint Color", group=GRP_STYLE, display=display.none)
lineWidth     = input.int(2, "Line Width", minval=1, maxval=4, group=GRP_STYLE, display=display.none)
lineStyle     = input.string("Dotted", "Line Style", options=["Solid", "Dashed", "Dotted"], group=GRP_STYLE, display=display.none)

// --- Labels ---
showLabels       = input.bool(true, "Show Labels", group=GRP_LABELS, display=display.none)
labelSize        = input.string("normal", "Label Size", options=["tiny", "small", "normal"], group=GRP_LABELS, display=display.none)
showPriceInLabel = input.bool(false, "Show Price in Label", group=GRP_LABELS, display=display.none)
labelOffset      = input.int(20, "Label Offset (bars)", minval=1, maxval=100, group=GRP_LABELS, display=display.none)
showBarMarkers   = input.bool(true, "Show Current Bar Markers", group=GRP_LABELS, display=display.none)

// ─────────────────────────────────────────────────────────────
// DERIVED
// ─────────────────────────────────────────────────────────────

int subdivisions = levelMode == "5" ? 2 : 4

// ─────────────────────────────────────────────────────────────
// HELPERS
// ─────────────────────────────────────────────────────────────

getLineStyle(string s) =>
    switch s
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

getLabelSize(string s) =>
    switch s
        "tiny"  => size.tiny
        "small" => size.small
        => size.normal

// ─────────────────────────────────────────────────────────────
// LEVEL NAMES
//
// 9 levels (subdivisions = 4):
//   i=+4   extreme        (furthest extension above range)
//   i=+3   extension      (first level beyond RH)
//   i=+2   RH             (≈ anchored high)
//   i=+1   quarter        (between RM and RH)
//   i= 0   RM             (range midpoint)
//   i=-1   quarter        (between RM and RL)
//   i=-2   RL             (≈ anchored low)
//   i=-3   extension      (first level beyond RL)
//   i=-4   extreme        (furthest extension below range)
//
// 5 levels (subdivisions = 2):
//   i=+2   extreme
//   i=+1   RH
//   i= 0   RM
//   i=-1   RL
//   i=-2   extreme
// ─────────────────────────────────────────────────────────────

getLevelDescription(int idx, int total, float price, float currentClose) =>
    string desc = ""
    string side = price > currentClose ? "R" : "S"

    if idx == 0
        desc := side + " — RM"
    else
        float ratio = total > 0 ? math.abs(idx) / total : 0.0
        bool isPositive = idx > 0

        if ratio >= 0.99
            // Extreme: outermost level
            desc := side + " — Extreme"
        else if math.abs(ratio - 0.5) < 0.01
            // Range boundary: ≈ anchored high or low
            desc := side + (isPositive ? " — RH" : " — RL")
        else if ratio > 0.5
            // Beyond range boundary
            desc := side + " — Extension"
        else
            // Between midpoint and boundary
            desc := side + " — Quarter"
    desc

// ─────────────────────────────────────────────────────────────
// RANGE & SQRT CALCULATION
// ─────────────────────────────────────────────────────────────

float finalHigh = math.max(manualHigh, manualLow)
float finalLow  = math.min(manualHigh, manualLow)
float midPrice  = (finalHigh + finalLow) / 2.0
float rangeSize = finalHigh - finalLow

float sqrtHigh  = math.sqrt(finalHigh)
float sqrtLow   = math.sqrt(finalLow)
float sqrtRange = sqrtHigh - sqrtLow
float increment = subdivisions > 0 ? sqrtRange / subdivisions : 1.0

// ─────────────────────────────────────────────────────────────
// DRAWING
// ─────────────────────────────────────────────────────────────

var line[]  drawnLines   = array.new_line(0)
var label[] drawnLabels  = array.new_label(0)
var line[]  drawnMarkers = array.new_line(0)

if barstate.islast and manualHigh > 0 and manualLow > 0 and rangeSize > 0

    // --- Cleanup ---
    if array.size(drawnLines) > 0
        for i = 0 to array.size(drawnLines) - 1
            line.delete(array.get(drawnLines, i))
    array.clear(drawnLines)

    if array.size(drawnLabels) > 0
        for i = 0 to array.size(drawnLabels) - 1
            label.delete(array.get(drawnLabels, i))
    array.clear(drawnLabels)

    if array.size(drawnMarkers) > 0
        for i = 0 to array.size(drawnMarkers) - 1
            line.delete(array.get(drawnMarkers, i))
    array.clear(drawnMarkers)

    // --- Calculate and draw ---
    float sqrtMid      = math.sqrt(midPrice)
    float currentClose = close

    int lineStart = bar_index - 500
    int lineEnd   = bar_index + 50

    for i = -subdivisions to subdivisions
        float sqrtLevel = sqrtMid + (i * increment)
        if sqrtLevel > 0
            float price = sqrtLevel * sqrtLevel
            float ratio = i == 0 ? 0.0 : math.abs(i) / subdivisions
            bool isPivot    = i == 0
            bool isBoundary = math.abs(ratio - 0.5) < 0.01
            bool isExtreme  = ratio >= 0.99
            bool isR        = price > currentClose

            color lineCol = isPivot ? midpointColor : (isBoundary or isExtreme ? boundaryColor : baseColor)
            int lineW     = isPivot ? lineWidth + 1 : lineWidth

            // Main level line
            array.push(drawnLines, line.new(
                 lineStart, price,
                 lineEnd, price,
                 color=lineCol, width=lineW,
                 style=getLineStyle(lineStyle),
                 extend=extendLevels ? extend.both : extend.none))

            // Current bar marker
            if showBarMarkers
                array.push(drawnMarkers, line.new(
                     bar_index, price,
                     bar_index + 1, price,
                     color=lineCol, width=lineW + 1,
                     style=line.style_solid))

            // Label
            if showLabels
                string desc = getLevelDescription(i, subdivisions, price, currentClose)

                if desc != ""
                    string txt = showPriceInLabel ? "● " + desc + "  " + str.tostring(price, format.mintick) + " ●" : "● " + desc + " ●"

                    array.push(drawnLabels, label.new(
                         bar_index + labelOffset, price, txt,
                         color=color.new(color.black, 100), textcolor=lineCol,
                         style=isR ? label.style_label_lower_left : label.style_label_upper_left,
                         size=getLabelSize(labelSize)))
