//@version=6
indicator("Gann Pivots", overlay=true, max_lines_count=500, max_labels_count=500)

// ─────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────

string GRP_CORE   = "Core Settings"
string GRP_ANCHOR = "Range Anchoring"
string GRP_STYLE  = "Visual Style"
string GRP_LABELS = "Labels"

// --- Core ---
showMinorLevels = input.bool(true, "Show Minor Levels", group=GRP_CORE, display=display.none,
     tooltip="Toggle thinner intermediate levels.")

// --- Anchor Mode ---
anchorMode = input.string("Rolling", "Anchor Mode", options=["Rolling", "Manual"], group=GRP_ANCHOR, display=display.none,
     tooltip="Rolling: recalculates every bar from lookback window (adaptive, some level drift).\nManual: uses your specified high/low inputs (fully static, requires your structural judgment).")

manualHigh = input.float(0.0, "Manual Range High", minval=0.0, group=GRP_ANCHOR, display=display.none,
     tooltip="Only used in Manual mode. Set to the high of your structural range.")
manualLow  = input.float(0.0, "Manual Range Low", minval=0.0, group=GRP_ANCHOR, display=display.none,
     tooltip="Only used in Manual mode. Set to the low of your structural range.")

// --- Style ---
extendLevels = input.bool(true, "Extend Lines", group=GRP_STYLE, display=display.none)
majorColor   = input.color(color.new(color.white, 25), "Major Level Color", group=GRP_STYLE, display=display.none)
minorColor   = input.color(color.new(color.white, 70), "Minor Level Color", group=GRP_STYLE, display=display.none)
extremeColor = input.color(color.new(color.white, 0), "Extreme Level Color", group=GRP_STYLE, display=display.none)
pivotColor   = input.color(color.new(color.white, 0), "Pivot Level Color", group=GRP_STYLE, display=display.none)
majorWidth   = input.int(2, "Major Line Width", minval=1, maxval=4, group=GRP_STYLE, display=display.none)
minorWidth   = input.int(1, "Minor Line Width", minval=1, maxval=4, group=GRP_STYLE, display=display.none)
lineStyle    = input.string("Dotted", "Line Style", options=["Solid", "Dashed", "Dotted"], group=GRP_STYLE, display=display.none)

// --- Labels ---
showLabels       = input.bool(true, "Show Labels", group=GRP_LABELS, display=display.none)
labelSize        = input.string("normal", "Label Size", options=["tiny", "small", "normal"], group=GRP_LABELS, display=display.none)
showPriceInLabel = input.bool(false, "Show Price in Label", group=GRP_LABELS, display=display.none)
labelOffset      = input.int(20, "Label Offset (bars)", minval=1, maxval=100, group=GRP_LABELS, display=display.none)
showBarMarkers   = input.bool(true, "Show Current Bar Markers", group=GRP_LABELS, display=display.none)

// ─────────────────────────────────────────────────────────────
// HARDCODED CONSTANTS
// ─────────────────────────────────────────────────────────────

int levelCount = 8

// Auto lookback: 500 for H6 and below, 250 for daily, 120 for multi-day
int autoLookback = timeframe.in_seconds() <= 21600 ? 500 : timeframe.in_seconds() <= 86400 ? 250 : 120

// ─────────────────────────────────────────────────────────────
// HELPERS
// ─────────────────────────────────────────────────────────────

getLineStyle(string s) =>
    switch s
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

getLabelSize(string s) =>
    switch s
        "tiny"  => size.tiny
        "small" => size.small
        => size.normal

// ─────────────────────────────────────────────────────────────
// LEVEL DESCRIPTIONS
// ─────────────────────────────────────────────────────────────

getLevelDescription(int idx, int total, float price, float currentClose) =>
    string desc = ""
    float ratio = total > 0 ? math.abs(idx) / total : 0.0
    bool isResistance = price > currentClose

    if idx == 0
        desc := isResistance ? "Resistance — range midpoint" : "Support — range midpoint"
    else if math.abs(price - currentClose) / currentClose < 0.001
        desc := "Current price pivot"
    else if ratio >= 0.95
        desc := isResistance ? "Ultimate resistance" : "Ultimate support"
    else if ratio >= 0.85
        desc := isResistance ? "Strong resistance — overextended" : "Strong support — overextended"
    else if ratio >= 0.75
        desc := isResistance ? "Strong resistance — reversal" : "Strong support — reversal"
    else if ratio >= 0.65
        desc := isResistance ? "Resistance — deviation" : "Support — deviation"
    else if ratio >= 0.55
        desc := isResistance ? "Resistance — range extreme" : "Support — range extreme"
    else if ratio >= 0.45
        desc := isResistance ? "Resistance — mid-range" : "Support — mid-range"
    else if ratio >= 0.35
        desc := isResistance ? "Resistance — range boundary" : "Support — range boundary"
    else if ratio >= 0.25
        desc := isResistance ? "Resistance — inner range" : "Support — inner range"
    else if ratio >= 0.15
        desc := isResistance ? "Minor resistance — transitional" : "Minor support — transitional"
    else if ratio >= 0.10
        desc := isResistance ? "Minor resistance" : "Minor support"
    desc

// ─────────────────────────────────────────────────────────────
// RANGE DETECTION
// ─────────────────────────────────────────────────────────────

int safeLb        = math.max(1, math.min(autoLookback, bar_index + 1))
float rollingHigh = ta.highest(high, safeLb)
float rollingLow  = ta.lowest(low, safeLb)

float rangeHigh = anchorMode == "Manual" and manualHigh > 0 ? manualHigh : rollingHigh
float rangeLow  = anchorMode == "Manual" and manualLow > 0  ? manualLow  : rollingLow

float finalHigh = math.max(rangeHigh, rangeLow)
float finalLow  = math.min(rangeHigh, rangeLow)

float midPrice  = (finalHigh + finalLow) / 2.0
float rangeSize = finalHigh - finalLow

// ─────────────────────────────────────────────────────────────
// SQRT INCREMENT CALCULATION
// ─────────────────────────────────────────────────────────────

float sqrtHigh      = math.sqrt(finalHigh)
float sqrtLow       = math.sqrt(finalLow)
float sqrtRange     = sqrtHigh - sqrtLow
float increment     = levelCount > 0 ? sqrtRange / levelCount : 1.0

// ─────────────────────────────────────────────────────────────
// DRAWING
// ─────────────────────────────────────────────────────────────

var line[]  drawnLines   = array.new_line(0)
var label[] drawnLabels  = array.new_label(0)
var line[]  drawnMarkers = array.new_line(0)

if barstate.islast and not na(finalHigh) and not na(finalLow) and rangeSize > 0

    // --- Cleanup ---
    if array.size(drawnLines) > 0
        for i = 0 to array.size(drawnLines) - 1
            line.delete(array.get(drawnLines, i))
    array.clear(drawnLines)

    if array.size(drawnLabels) > 0
        for i = 0 to array.size(drawnLabels) - 1
            label.delete(array.get(drawnLabels, i))
    array.clear(drawnLabels)

    if array.size(drawnMarkers) > 0
        for i = 0 to array.size(drawnMarkers) - 1
            line.delete(array.get(drawnMarkers, i))
    array.clear(drawnMarkers)

    // --- Calculate and draw ---
    float sqrtMid      = math.sqrt(midPrice)
    float currentClose = close

    int lineStart = bar_index - math.min(safeLb, 500)
    int lineEnd   = bar_index + 50

    string lvlExtend = extendLevels ? "both" : "none"

    for i = -levelCount to levelCount
        float sqrtLevel = sqrtMid + (i * increment)
        if sqrtLevel > 0
            float price    = sqrtLevel * sqrtLevel
            float ratio    = i == 0 ? 0.0 : math.abs(i) / levelCount
            bool isPivot   = i == 0
            bool isExtreme = ratio >= 0.85
            bool isMajor   = isPivot or ratio >= 0.35
            bool isSkipped = ratio < 0.10 and i != 0
            bool shouldDraw = (isMajor or showMinorLevels) and not isSkipped

            if shouldDraw
                bool isResistance = price > currentClose

                color lineCol = isPivot ? pivotColor : (isExtreme ? extremeColor : (isMajor ? majorColor : minorColor))
                int lineW     = isPivot ? majorWidth + 1 : (isMajor ? majorWidth : minorWidth)

                // Main level line
                array.push(drawnLines, line.new(
                     lineStart, price,
                     lineEnd, price,
                     color=lineCol, width=lineW,
                     style=getLineStyle(lineStyle),
                     extend=lvlExtend == "both" ? extend.both : extend.none))

                // Current bar marker
                if showBarMarkers
                    array.push(drawnMarkers, line.new(
                         bar_index, price,
                         bar_index + 1, price,
                         color=lineCol, width=lineW + 1,
                         style=line.style_solid))

                // Label
                if showLabels
                    string desc = getLevelDescription(i, levelCount, price, currentClose)

                    if desc != ""
                        string txt = showPriceInLabel ? "● " + desc + "  " + str.tostring(price, format.mintick) + " ●" : "● " + desc + " ●"

                        array.push(drawnLabels, label.new(
                             bar_index + labelOffset, price, txt,
                             color=color.new(color.black, 100), textcolor=lineCol,
                             style=isResistance ? label.style_label_lower_left : label.style_label_upper_left,
                             size=getLabelSize(labelSize)))
